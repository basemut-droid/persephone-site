---
// The /blog/ listing's own row (FIXES-2026-09-07.md task 3) — distinct from
// BlogTeaserCard.astro (the homepage's compact teaser-grid card): the live
// listing is full-width single-column rows with a divider line between
// them, a red date badge (day large, month/year small), the description
// sentence, a byline, and "Weiterlesen" right-aligned — a different shape
// from a grid of cards, not a smaller version of one, so it's a separate
// component rather than a variant prop on BlogTeaserCard forcing one shape
// to serve two unrelated layouts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  publishDate: Date;
  category?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  byline: string;
  readMoreLabel: string;
}
const { href, title, description, publishDate, category, heroImage, heroImageAlt, byline, readMoreLabel } = Astro.props;

const day = publishDate.toLocaleDateString('de-AT', { day: 'numeric' });
const monthYear = publishDate.toLocaleDateString('de-AT', { month: 'short', year: 'numeric' });
const isoDate = publishDate.toISOString().slice(0, 10);
---

<article class="blog-row">
  <a href={href} class="blog-row-image" aria-hidden={heroImage ? undefined : 'true'}>
    {
      heroImage ? (
        <Image src={heroImage} alt={heroImageAlt ?? ''} width={300} height={220} loading="lazy" />
      ) : (
        <span class="image-placeholder">Bild folgt</span>
      )
    }
  </a>

  <time class="blog-row-date" datetime={isoDate}>
    <span class="day">{day}</span>
    <span class="month-year">{monthYear}</span>
  </time>

  <div class="blog-row-body">
    {category && category.length > 0 && <p class="blog-row-category">{category.join(', ')}</p>}
    <h3><a href={href}>{title}</a></h3>
    <p class="blog-row-description">{description}</p>
    <p class="blog-row-byline">{byline}</p>
  </div>

  <a href={href} class="blog-row-link">{readMoreLabel} →</a>
</article>

<style>
  .blog-row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'image date'
      'image body'
      'image link';
    column-gap: 1.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid rgba(24, 26, 43, 0.1);
  }

  .blog-row:first-child {
    padding-top: 0;
  }

  .blog-row-image {
    grid-area: image;
    display: block;
    width: 140px;
    aspect-ratio: 3 / 4;
    background: var(--color-sage);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .blog-row-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-text-on-accent);
    font-size: 0.75rem;
    text-align: center;
    padding: 0.5rem;
  }

  .blog-row-date {
    grid-area: date;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--color-accent-strong);
    color: var(--color-surface);
    border-radius: var(--radius);
    padding: 0.4rem 0.85rem;
    width: fit-content;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .blog-row-date .day {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .blog-row-date .month-year {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .blog-row-body {
    grid-area: body;
  }

  .blog-row-category {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .blog-row-body h3 {
    margin: 0 0 0.5rem;
  }

  .blog-row-body h3 a {
    text-decoration: none;
    color: var(--color-text);
  }

  .blog-row-description {
    margin: 0 0 0.5rem;
  }

  .blog-row-byline {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .blog-row-link {
    grid-area: link;
    justify-self: end;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-accent-strong);
  }

  @media (max-width: 600px) {
    .blog-row {
      grid-template-columns: 1fr;
      grid-template-areas:
        'image'
        'date'
        'body'
        'link';
    }

    .blog-row-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      margin-bottom: 1rem;
    }
  }
</style>
