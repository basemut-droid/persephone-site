---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  category?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  readMoreLabel: string;
}
const { href, title, category, heroImage, heroImageAlt, readMoreLabel } = Astro.props;
---

<article class="blog-teaser">
  <a href={href} class="blog-teaser-image" aria-label={heroImage ? title : undefined} aria-hidden={heroImage ? undefined : 'true'}>
    {
      heroImage ? (
        <Image src={heroImage} alt={heroImageAlt ?? ''} width={400} height={260} loading="lazy" />
      ) : (
        <span class="image-placeholder">Bild folgt</span>
      )
    }
  </a>
  {/* NACHTLAUF-2026-09-08.md B1: live's white card overlaps the image
     (a negative margin pulling it left over the image's edge), rather than
     sitting beside it in its own column — layout only; per Marina's
     2026-09-07 decision the title stays dark/normal-case and the link
     stays "Weiterlesen →", not live's terracotta-uppercase treatment. */}
  <div class="blog-teaser-body">
    {category && category.length > 0 && <p class="eyebrow blog-teaser-category">{category.join(', ')}</p>}
    <h3><a href={href}>{title}</a></h3>
    <a href={href} class="blog-teaser-link">{readMoreLabel} →</a>
  </div>
</article>

<style>
  /* NACHTLAUF-2026-09-09.md E4: equal-height cards within a .blog-grid
     row, same idea as .format-card/.workshop-card's flex-column +
     height: 100% — a 4-line title (e.g. "Männer im Kinderwunsch: Mythos
     'stille Stärke'") used to leave its row's shorter 2-line-title card
     visibly smaller. height: 100% fills the stretched grid cell
     .blog-grid's default align-items: stretch already gives this article;
     grid-template-rows: 1fr then lets image + body actually reach that
     full height instead of only their own content's natural size. */
  .blog-teaser {
    display: grid;
    grid-template-columns: minmax(140px, 55%) 1fr;
    grid-template-rows: 1fr;
    align-items: stretch;
    height: 100%;
  }

  .blog-teaser-image {
    display: block;
    grid-column: 1;
    grid-row: 1;
    aspect-ratio: 4 / 3;
    background: var(--color-sage);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .blog-teaser-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-text-on-accent);
    font-size: 0.8rem;
  }

  /* The overlap: the card sits in its own grid column but is pulled left
     with a negative margin so it reaches back over the image's edge,
     matching live's "white card breaks out over the photo" composition
     (NACHTLAUF-2026-09-08.md B1) instead of sitting beside it. */
  .blog-teaser-body {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    z-index: 1;
    margin-left: -2.5rem;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(24, 26, 43, 0.12);
    padding: 1.5rem 1.75rem;
    /* Same equal-height fix as .blog-teaser above: the link stays
       anchored to the bottom regardless of how many lines the title
       above it wraps to. */
    display: flex;
    flex-direction: column;
  }

  /* NACHTLAUF-2026-09-09.md E4: live measures this at 18px/uppercase/teal,
     i.e. exactly .eyebrow's own shape (global.css) — this card now uses
     that class directly; only the tighter card spacing stays local. */
  .blog-teaser-category {
    margin-bottom: 0.5rem;
  }

  .blog-teaser-body h3 {
    margin: 0 0 0.75rem;
    /* VERGLEICH-2026-09-07.md A1: live 26px on every blog-teaser title,
       matching /blog/'s own listing (already correct there via the shared
       h3 clamp) — this card had its own smaller override. */
    font-size: 1.625rem;
  }

  .blog-teaser-body h3 a {
    text-decoration: none;
    color: var(--color-text);
  }

  /* NACHTLAUF-2026-09-09.md E4: live's "Weiterlesen"-equivalent link
     measures teal (--color-accent), 15px — this was terracotta
     (--color-accent-strong) at 13.6px. */
  .blog-teaser-link {
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-accent);
    margin-top: auto;
  }

  @media (max-width: 600px) {
    .blog-teaser {
      grid-template-columns: 1fr;
    }
    .blog-teaser-image {
      grid-row: 1;
    }
    .blog-teaser-body {
      grid-row: 2;
      margin-left: 0;
      margin-top: -2rem;
      padding: 1.25rem 1.5rem;
    }
  }
</style>
