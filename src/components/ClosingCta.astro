---
// The site-wide closing-CTA composition (docs/RUN-2026-09-07.md Phase C /
// FIXES-2026-09-07.md task 2f, superseding the narrower task 2b.3). Confirmed
// against the live site's raw HTML (curled directly, not a text conversion) on
// Angebote, Workshops, Beratung and Über uns: a nested column holding the
// portrait, offset with a CSS transform and z-index:999, sitting beside/over a
// second nested column holding a per-page decorative tile image — the same two
// pieces this rebuild had already extracted as separate, unrelated-looking
// assets (external-review.md finding #9) and never assembled together.
//
// Two columns: left is heading/paragraphs/button, left-aligned. Right is the
// portrait, offset over the tile, both squares, the photograph overlapping
// the tile's bottom-left corner. The colourway comes entirely from the tile
// image itself — nothing here hardcodes a per-page color, so each page's own
// logo tone (brown, teal, dark teal, whatever that page's tile asset is)
// carries through unchanged. Stacks to one column on narrow viewports; the
// portrait/tile overlap is built as one relative visual unit, so it's
// preserved automatically in the stacked layout rather than needing a second,
// separate mobile composition.
//
// Live correction (2026-09-11, after the written run docs): this component
// had drifted into two different shapes across its four call sites — this
// "overlap" one (portrait offset over the tile) on Über uns/Angebote, and a
// second "pair" layout (two equal squares side by side, no overlap) on
// Workshops/Beratung. Asked to unify: same overlap shape everywhere, both
// elements square, and the portrait corrected to sit at the tile's
// bottom-LEFT (it was bottom-right) to match the reference. The `layout`
// prop and its "pair" branch are gone — there is only the one shape now.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  paragraphs: string[];
  ctaLabel: string;
  ctaHref: string;
  portrait: ImageMetadata;
  portraitAlt: string;
  tile: ImageMetadata;
  tileAlt: string;
  // NACHTLAUF-2026-09-08.md B2.3: Über uns's own CTA measures 48px/336x390,
  // both larger than every other page's use of this shared component (28px
  // heading, 230x307 portrait — the generic sizes below stay the default).
  // Opt-in per instance rather than a global size change, since VERGLEICH's
  // B3 confirms Angebote's own CTA heading is already correct at 28px.
  headingSize?: 'default' | 'large';
  portraitSize?: 'default' | 'large';
}
const {
  heading,
  paragraphs,
  ctaLabel,
  ctaHref,
  portrait,
  portraitAlt,
  tile,
  tileAlt,
  headingSize = 'default',
  portraitSize = 'default',
} = Astro.props;
---

<section class="section closing-cta">
  <div class="container closing-cta-grid">
    <div class:list={['closing-cta-copy', { 'heading-lg': headingSize === 'large' }]}>
      <h2>{heading}</h2>
      {paragraphs.map((p) => <p>{p}</p>)}
      <a href={ctaHref} class="button button-primary">{ctaLabel}</a>
    </div>
    <div class="closing-cta-visual">
      {/* Decorative brand tile — aria-hidden directly on the <img> itself
         (not just an empty alt, and not just an ancestor wrapper — the
         build-check's alt-text rule inspects each <img> tag on its own, so
         this is what it needs to see to tell "deliberately decorative"
         apart from "alt text someone forgot"). FIXES-2026-09-07.md task 5c. */}
      <div class="closing-cta-tile">
        <Image src={tile} alt={tileAlt} aria-hidden="true" width={500} height={500} />
      </div>
      <div class:list={['closing-cta-portrait', { 'portrait-lg': portraitSize === 'large' }]}>
        <Image src={portrait} alt={portraitAlt} width={500} height={500} />
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .closing-cta-copy h2 {
    color: var(--color-accent-strong);
  }

  /* NACHTLAUF-2026-09-08.md B2.3: Über uns's "Dein nächster Schritt" is
     its own measured 48px, not the shared 28px h2/h3 scale. */
  .closing-cta-copy.heading-lg h2 {
    font-size: 3rem;
  }

  .closing-cta-visual {
    position: relative;
    max-width: 24rem;
    margin-inline: auto;
    /* Room for the portrait to overhang the tile's left/bottom edges
       without colliding with the section padding — mirrored from the
       original right-side padding now that the portrait sits on the
       left (live correction, 2026-09-11). */
    padding: 0 0 2.5rem 1.5rem;
  }

  .closing-cta-tile,
  .closing-cta-portrait {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .closing-cta-tile {
    aspect-ratio: 1 / 1;
  }

  .closing-cta-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Live correction, 2026-09-11: the portrait sits at the tile's
     bottom-LEFT (was bottom-right) and is a square like the tile, not a
     3:4 portrait crop — this component had drifted into two different
     shapes across its four pages (this overlap, and a separate "pair"
     layout elsewhere in the file's history); unified to this one.
     Second correction, same day: portrait width raised to match the tile
     exactly (was 65%, read as "too small next to the logo") and the
     offset deepened from -1.5rem/-2rem to -3rem/-3rem for "mehr
     Überlappung" — two equal squares, offset enough that a clear
     L-shaped strip of the tile still shows top and right, not just a
     sliver. */
  .closing-cta-portrait {
    position: absolute;
    width: 100%;
    aspect-ratio: 1 / 1;
    left: -3rem;
    bottom: -3rem;
    box-shadow: 0 16px 32px rgba(24, 26, 43, 0.18);
  }

  .closing-cta-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* NACHTLAUF-2026-09-08.md B2.3: Über uns's whole photo/tile pair reads
     larger than every other page's use of this component — now that the
     portrait always matches the tile's own size, that difference lives
     on the shared container's own max-width instead of the portrait's
     width alone. */
  .closing-cta-visual:has(.portrait-lg) {
    max-width: 30rem;
  }

  .closing-cta-portrait.portrait-lg {
    width: 92%;
  }

  @media (min-width: 900px) {
    .closing-cta-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
