---
// The site-wide closing-CTA composition (docs/RUN-2026-09-07.md Phase C /
// FIXES-2026-09-07.md task 2f, superseding the narrower task 2b.3). Confirmed
// against the live site's raw HTML (curled directly, not a text conversion) on
// Angebote, Workshops, Beratung and Über uns: a nested column holding the
// portrait, offset with a CSS transform and z-index:999, sitting beside/over a
// second nested column holding a per-page decorative tile image — the same two
// pieces this rebuild had already extracted as separate, unrelated-looking
// assets (external-review.md finding #9) and never assembled together.
//
// Two columns: left is heading/paragraphs/button, left-aligned. Right is the
// portrait, offset over the tile, both rounded, the photograph overlapping the
// tile. The colourway comes entirely from the tile image itself — nothing here
// hardcodes a per-page color. Stacks to one column on narrow viewports; the
// portrait/tile overlap is built as one relative visual unit, so it's
// preserved automatically in the stacked layout rather than needing a second,
// separate mobile composition.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  paragraphs: string[];
  ctaLabel: string;
  ctaHref: string;
  portrait: ImageMetadata;
  portraitAlt: string;
  tile: ImageMetadata;
  tileAlt: string;
}
const { heading, paragraphs, ctaLabel, ctaHref, portrait, portraitAlt, tile, tileAlt } = Astro.props;
---

<section class="section closing-cta">
  <div class="container closing-cta-grid">
    <div class="closing-cta-copy">
      <h2>{heading}</h2>
      {paragraphs.map((p) => <p>{p}</p>)}
      <a href={ctaHref} class="button button-primary">{ctaLabel}</a>
    </div>
    <div class="closing-cta-visual">
      <div class="closing-cta-tile">
        <Image src={tile} alt={tileAlt} width={500} height={500} />
      </div>
      <div class="closing-cta-portrait">
        <Image src={portrait} alt={portraitAlt} width={400} height={520} />
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .closing-cta-copy h2 {
    color: var(--color-accent-strong);
  }

  .closing-cta-visual {
    position: relative;
    max-width: 24rem;
    margin-inline: auto;
    /* Room for the portrait to overhang the tile's edges without colliding
       with the section padding. */
    padding: 0 1.5rem 2.5rem 0;
  }

  .closing-cta-tile,
  .closing-cta-portrait {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .closing-cta-tile {
    aspect-ratio: 1 / 1;
  }

  .closing-cta-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .closing-cta-portrait {
    position: absolute;
    width: 60%;
    aspect-ratio: 3 / 4;
    right: -1.5rem;
    bottom: -2rem;
    box-shadow: 0 16px 32px rgba(24, 26, 43, 0.18);
  }

  .closing-cta-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .closing-cta-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
