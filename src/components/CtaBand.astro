---
// The one full-bleed colored CTA strip pattern used across the site (the
// homepage's newsletter section, and every subpage's closing CTA) — kept
// as one component so all of them stay pixel-identical instead of drifting
// into slightly different ad-hoc versions per page.
interface Props {
  eyebrow?: string;
  heading?: string;
  paragraphs: string[];
  ctaLabel: string;
  ctaHref: string;
}
const { eyebrow, heading, paragraphs, ctaLabel, ctaHref } = Astro.props;
---

<section class="section cta-band">
  <div class="container cta-inner">
    {eyebrow && <span class="eyebrow eyebrow-on-band">{eyebrow}</span>}
    {heading && <h2>{heading}</h2>}
    {paragraphs.map((p) => <p>{p}</p>)}
    <a href={ctaHref} class="button button-primary">{ctaLabel}</a>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-band-bg);
    color: var(--color-text-on-accent);
    text-align: center;
  }

  .cta-inner {
    /* 56rem, matching .section-narrow — the same measure the homepage's
       other centered-copy section (pain-points) uses, rather than the
       odd one-off 60ch this used to be. */
    max-width: 56rem;
    margin-inline: auto;
  }

  /* Explicit rhythm instead of relying on each element's bare default
     margin — uses the spacing scale from DESIGN-SYSTEM.md. The eyebrow's
     own default margin-bottom (0.75rem, global.css) already lands
     exactly on --space-2, so it's left alone; only the two gaps that
     were compressed get an explicit token. */
  .cta-inner h2 {
    margin-bottom: var(--space-6); /* matches .section-heading's rhythm */
  }

  .cta-inner p:last-of-type {
    margin-bottom: var(--space-7); /* generous pre-button gap, on-scale */
  }

  .eyebrow-on-band {
    color: var(--color-text-on-accent);
    opacity: 0.85;
  }
</style>
