---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/utils';
import signet from '../assets/logo/signet.png';

interface Props {
  locale: Locale;
  footer: {
    tagline: string;
    newsletterEyebrow: string;
    newsletterCta: string;
    columns: { title: string; links: { label: string; href: string }[] }[];
    copyright: string;
  };
}
const { footer } = Astro.props;
const year = new Date().getFullYear();
const copyright = footer.copyright.replace('{year}', String(year));
---

<div class="footer-wave" aria-hidden="true">
  <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
    <path
      d="M0,18 C40,12 80,22 130,16 C190,9 230,20 290,14 C350,8 400,19 460,13 C520,7 570,17 630,12 C700,6 750,18 820,11 C880,6 930,16 990,10 C1050,5 1100,15 1160,10 C1220,6 1270,14 1330,9 C1370,6 1400,12 1440,9 L1440,40 L0,40 Z"
      fill="#e9dccd"
    />
  </svg>
</div>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Image src={signet} alt="Persephone" width={72} height={73} class="footer-logo" />
      <p class="footer-tagline">{footer.tagline}</p>
      <span class="eyebrow footer-nl-eyebrow">{footer.newsletterEyebrow}</span>
      <a href="/newsletter/" class="footer-nl-link">{footer.newsletterCta} →</a>
    </div>

    {
      footer.columns.map((column) => (
        <nav class="footer-column" aria-label={column.title}>
          <p class="footer-column-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container">
    <p class="footer-copyright">{copyright}</p>
  </div>
</footer>

<style>
  .footer-wave {
    /* Transparent: the newsletter band above shows through naturally right
       up to the painted edge, instead of this wrapper adding its own
       second flat-color strip on top of the SVG. Gap goes above the
       wave (between it and the teal band), not below it. */
    margin-top: 6rem;
  }

  .footer-wave svg {
    display: block;
    width: 100%;
    height: 40px;
  }

  .site-footer {
    /* Same literal color as the separator's fill above, so the painted
       edge and the footer read as one continuous surface. */
    background: #e9dccd;
    color: var(--color-text);
    padding-block: 3rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }

  .footer-logo {
    border-radius: var(--radius);
    margin: 0 0 0.75rem;
  }

  .footer-tagline {
    color: var(--color-accent);
    font-weight: 700;
    max-width: 26ch;
    border-left: 3px solid var(--color-accent-strong);
    padding-left: 0.9rem;
  }

  .footer-nl-eyebrow {
    color: var(--color-accent-strong);
  }

  .footer-nl-link {
    text-decoration: underline;
    font-weight: 600;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column-title {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-column a {
    text-decoration: none;
    color: var(--color-text);
    opacity: 0.85;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer-copyright {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(24, 26, 43, 0.12);
    font-size: 0.8rem;
    color: var(--color-accent-strong);
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
