---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/utils';
import signet from '../assets/logo/signet.png';

interface Props {
  locale: Locale;
  footer: {
    tagline: string;
    newsletterEyebrow: string;
    newsletterCta: string;
    columns: { title: string; links: { label: string; href: string }[] }[];
    copyright: string;
  };
}
const { footer } = Astro.props;
const year = new Date().getFullYear();
const copyright = footer.copyright.replace('{year}', String(year));
---

<div class="footer-wave" aria-hidden="true">
  <!-- NACHTLAUF-2026-09-08.md A5: a hand-drawn brushstroke edge, not the
       smooth regular wave this replaces. Irregular amplitude and spacing
       (no repeating period, unlike a sine-wave path) so it doesn't read as
       geometric, and the amplitude tapers down toward both ends (a real
       brush thins out as it lifts off the canvas) instead of the pattern
       running unchanged into the viewport edge. Gestalterische Freiheit
       ausdrücklich erteilt — own path, not the live Avada separator. -->
  <svg viewBox="0 0 1440 50" preserveAspectRatio="none">
    <path
      class="footer-wave-path"
      d="M0,32 C25,26 45,36 75,29 C115,20 140,34 180,24 C225,13 255,31 300,21 C345,10 375,29 420,17 C470,6 500,27 550,19 C600,9 630,30 680,22 C730,12 760,33 810,25 C855,14 885,32 930,20 C975,8 1005,26 1050,16 C1090,7 1120,24 1160,18 C1200,11 1225,28 1265,23 C1300,17 1325,30 1360,26 C1390,22 1410,29 1440,27 L1440,50 L0,50 Z"
    />
  </svg>
</div>
<footer class="site-footer">
  <div class:list={['container', 'footer-grid', { 'footer-grid-brand-only': footer.columns.length === 0 }]}>
    <div class="footer-brand">
      <Image src={signet} alt="Persephone" width={72} height={73} class="footer-logo" />
      <p class="footer-tagline">{footer.tagline}</p>
      <span class="eyebrow footer-nl-eyebrow">{footer.newsletterEyebrow}</span>
      <a href="/newsletter/" class="footer-nl-link">{footer.newsletterCta} →</a>
    </div>

    {
      footer.columns.map((column) => (
        <nav class="footer-column" aria-label={column.title}>
          <p class="footer-column-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container">
    <p class="footer-copyright">{copyright}</p>
  </div>
</footer>

<style>
  .footer-wave {
    /* Transparent: the newsletter band above shows through naturally right
       up to the painted edge, instead of this wrapper adding its own
       second flat-color strip on top of the SVG. Gap goes above the
       wave (between it and the teal band), not below it. */
    margin-top: 6rem;
  }

  .footer-wave svg {
    display: block;
    width: 100%;
    height: 40px;
  }

  .footer-wave-path {
    fill: var(--color-footer-bg);
  }

  .site-footer {
    /* Same token as the separator's fill above, so the painted edge and
       the footer read as one continuous surface. */
    background: var(--color-footer-bg);
    color: var(--color-text);
    padding-block: 3rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }

  /* Guards against a page ever shipping zero footer columns (a locale with
     no legal links of its own yet, say) — without this, the brand column
     would sit in a 3-column grid with two empty tracks reserved beside it.
     EN/IT used to hit this every time (RUN-2026-09-07-B1.md Phase 0.3
     gave them the German legal pages instead), so the class stays as a
     safety net rather than being removed now that it's unused. */
  .footer-grid-brand-only {
    grid-template-columns: 1fr;
  }

  .footer-logo {
    border-radius: var(--radius);
    margin: 0 0 0.75rem;
  }

  .footer-tagline {
    color: var(--color-accent);
    font-weight: 700;
    max-width: 26ch;
    border-left: 3px solid var(--color-accent-strong);
    padding-left: 0.9rem;
  }

  .footer-nl-eyebrow {
    color: var(--color-accent-strong);
  }

  .footer-nl-link {
    text-decoration: underline;
    font-weight: 600;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column-title {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-column a {
    text-decoration: none;
    color: var(--color-text);
    opacity: 0.85;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer-copyright {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(24, 26, 43, 0.12);
    font-size: 0.8rem;
    color: var(--color-accent-strong);
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
