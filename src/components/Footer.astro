---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/utils';
import signet from '../assets/logo/signet.png';

interface Props {
  locale: Locale;
  footer: {
    tagline: string;
    newsletterEyebrow: string;
    newsletterCta: string;
    columns: { title: string; links: { label: string; href: string }[] }[];
    copyright: string;
  };
}
const { footer } = Astro.props;
const year = new Date().getFullYear();
const copyright = footer.copyright.replace('{year}', String(year));
---

<!-- LAUF-2026-09-10.md A6: the wavy brushstroke separator above (NACHTLAUF-
     2026-09-08.md A5) reads as "komisch" to Marina. The live original's own
     separator graphic is an Avada asset (BILDRECHTE) and stays off-limits,
     so Claudio decided this becomes a plain, restrained line instead — not
     a brushstroke redraw. See .footer-divider below. -->
<footer class="site-footer">
  <div class:list={['container', 'footer-grid', { 'footer-grid-brand-only': footer.columns.length === 0 }]}>
    <div class="footer-brand">
      <Image src={signet} alt="Persephone" width={72} height={73} class="footer-logo" />
      <p class="footer-tagline">{footer.tagline}</p>
      <span class="eyebrow footer-nl-eyebrow">{footer.newsletterEyebrow}</span>
      <a href="/newsletter/" class="footer-nl-link">{footer.newsletterCta} →</a>
    </div>

    {
      footer.columns.map((column) => (
        <nav class="footer-column" aria-label={column.title}>
          <p class="footer-column-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container">
    <p class="footer-copyright">{copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    /* LAUF-2026-09-10.md A5: live measures the footer background at
       #f3ece6 (--color-bg-alt) — this was the untokenized #e9dccd literal
       (never present on the live site), now removed from the project
       rather than just overridden here. */
    background: var(--color-bg-alt);
    color: var(--color-text);
    padding-block: 3rem 1.5rem;
    /* A6: replaces the wavy brushstroke separator that used to sit above
       this element — a restrained hairline in the footer's own tone
       instead, not a redrawn brushstroke. */
    border-top: 1px solid rgba(24, 26, 43, 0.15);
    margin-top: 6rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }

  /* Guards against a page ever shipping zero footer columns (a locale with
     no legal links of its own yet, say) — without this, the brand column
     would sit in a 3-column grid with two empty tracks reserved beside it.
     EN/IT used to hit this every time (RUN-2026-09-07-B1.md Phase 0.3
     gave them the German legal pages instead), so the class stays as a
     safety net rather than being removed now that it's unused. */
  .footer-grid-brand-only {
    grid-template-columns: 1fr;
  }

  .footer-logo {
    border-radius: var(--radius);
    margin: 0 0 0.75rem;
  }

  .footer-tagline {
    color: var(--color-accent);
    font-weight: 700;
    max-width: 26ch;
    border-left: 3px solid var(--color-accent-strong);
    padding-left: 0.9rem;
  }

  .footer-nl-eyebrow {
    color: var(--color-accent-strong);
    /* LAUF-2026-09-10.md A7: this eyebrow's own text is "Persephones
       e-Brief" — .eyebrow's uppercase transform (global.css) would turn
       that into "PERSEPHONES E-BRIEF", losing the required lowercase e.
       Versalien-Auszeichnung entfällt hier, statt das kleine e zu opfern. */
    text-transform: none;
  }

  .footer-nl-link {
    text-decoration: underline;
    font-weight: 600;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column-title {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-column a {
    /* LAUF-2026-09-10.md A5 "+ Schrift grün" — Marina's own recommendation
       is --color-teal-darker (see :root's comment for the contrast math);
       flagged in the handoff as proposed, pending her sign-off. Full
       opacity now that the color itself carries the contrast, rather than
       dimming a dark neutral as the old --color-text/opacity:0.85 did. */
    text-decoration: none;
    color: var(--color-teal-darker);
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column a:hover {
    text-decoration: underline;
  }

  .footer-copyright {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(24, 26, 43, 0.12);
    font-size: 0.8rem;
    color: var(--color-accent-strong);
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
