---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/utils';
import signet from '../assets/logo/signet.png';

interface Props {
  locale: Locale;
  footer: {
    tagline: string;
    newsletterEyebrow: string;
    newsletterCta: string;
    columns: { title: string; links: { label: string; href: string }[] }[];
    copyright: string;
  };
}
const { footer } = Astro.props;
const year = new Date().getFullYear();
const copyright = footer.copyright.replace('{year}', String(year));
---

<div class="footer-wave" aria-hidden="true">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
    <path
      d="M0,32 C240,64 480,0 720,20 C960,40 1200,64 1440,28 L1440,0 L0,0 Z"
      fill="var(--color-bg-alt)"
    />
  </svg>
</div>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Image src={signet} alt="Persephone" width={72} height={73} class="footer-logo" />
      <p class="footer-tagline">{footer.tagline}</p>
      <span class="eyebrow">{footer.newsletterEyebrow}</span>
      <a href="/newsletter/" class="footer-nl-link">{footer.newsletterCta} →</a>
    </div>

    {
      footer.columns.map((column) => (
        <nav class="footer-column" aria-label={column.title}>
          <p class="footer-column-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container">
    <p class="footer-copyright">{copyright}</p>
  </div>
</footer>

<style>
  .footer-wave {
    background: var(--color-band-bg);
    margin-top: -1px;
  }

  .footer-wave svg {
    display: block;
    width: 100%;
    height: 40px;
  }

  .site-footer {
    background: var(--color-bg-alt);
    color: var(--color-text);
    padding-block: 3rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }

  .footer-logo {
    border-radius: var(--radius);
    margin: 0 0 0.75rem;
  }

  .footer-tagline {
    color: var(--color-accent);
    font-weight: 700;
    max-width: 26ch;
    border-left: 3px solid var(--color-accent-strong);
    padding-left: 0.9rem;
  }

  .footer-nl-link {
    text-decoration: underline;
    font-weight: 600;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column-title {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-column a {
    text-decoration: none;
    color: var(--color-text);
    opacity: 0.85;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  .footer-column a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .footer-copyright {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(24, 26, 43, 0.12);
    font-size: 0.8rem;
    color: var(--color-accent-strong);
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
