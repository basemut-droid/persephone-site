---
import { Image } from 'astro:assets';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale } from '../i18n/utils';
import wordmark from '../assets/logo/wordmark-red.png';

interface NavLink {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}
interface Props {
  locale: Locale;
  path: string;
  nav: { items: NavLink[]; cta: string; ctaHref: string };
  switcherLabel: string;
  availableLocales?: readonly Locale[];
}
const { locale, path, nav, switcherLabel, availableLocales } = Astro.props;
const homeHref = locale === 'de' ? '/' : `/${locale}/`;
---

<header class="site-header">
  <div class="container header-inner">
    <a href={homeHref} class="logo" aria-label="Persephone – zur Startseite">
      <Image src={wordmark} alt="Persephone" width={400} height={106} />
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">Menü öffnen</span>
      <span aria-hidden="true">☰</span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Hauptnavigation">
      <ul>
        {
          nav.items.map((item, i) =>
            item.children ? (
              // "Angebote" (the one item with children) has to both navigate to
              // its own page AND disclose its submenu — a native
              // <details>/<summary> can only ever do one of those (external-
              // review.md finding #0). Split into a real <a> for navigation and
              // a separate toggle <button> for the submenu, so a click/tap on
              // either does exactly one thing: no ambiguity for touch, where a
              // single tap has no separate "hover first" step available.
              // Mouse users additionally get the submenu on hover (CSS below)
              // as a convenience; keyboard and touch always have the explicit
              // button.
              <li class="nav-dropdown">
                <div class="nav-dropdown-trigger">
                  <a href={item.href}>{item.label}</a>
                  <button
                    type="button"
                    class="nav-dropdown-toggle"
                    aria-expanded="false"
                    aria-controls={`nav-submenu-${i}`}
                  >
                    <span class="visually-hidden">{item.label} – Untermenü öffnen</span>
                    <span class="caret" aria-hidden="true">▾</span>
                  </button>
                </div>
                <ul id={`nav-submenu-${i}`} class="nav-dropdown-menu" hidden>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            )
          )
        }
      </ul>
      <a href={nav.ctaHref} class="button button-primary nav-cta">{nav.cta}</a>
      <LanguageSwitcher locale={locale} path={path} label={switcherLabel} availableLocales={availableLocales} />
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open', !expanded);
  });

  // Submenu disclosure: a plain aria-expanded/hidden toggle rather than
  // <details>, so the parent label can stay a real <a> (see the comment in
  // the markup above for why). Closes on outside click/focus and on Escape,
  // same behavior <details> gave us for free.
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  for (const dropdown of document.querySelectorAll<HTMLLIElement>('.nav-dropdown')) {
    const button = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-toggle');
    const menu = dropdown.querySelector<HTMLUListElement>('.nav-dropdown-menu');
    if (!button || !menu) continue;

    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const setOpen = (open: boolean) => {
      clearTimeout(closeTimer);
      button.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      dropdown.classList.toggle('is-open', open);
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    dropdown.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !dropdown.contains(next)) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) setOpen(false);
    });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false);
        button.focus();
      }
    });

    // Mouse convenience: open on entering the whole trigger+menu region,
    // close after a short delay so a diagonal or momentarily-imprecise
    // pointer path (e.g. cutting the corner toward the first menu item)
    // doesn't close the menu before it arrives. Fine pointers only — touch
    // (reports "coarse") never gets a hover-only open with no dismiss.
    if (canHover) {
      dropdown.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        setOpen(true);
      });
      dropdown.addEventListener('mouseleave', () => {
        closeTimer = setTimeout(() => setOpen(false), 180);
      });
    }
  }
</script>

<style>
  .site-header {
    /* Same surface as the hero directly below it — no separate band, no
       border, they read as one continuous background. */
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    padding-block: 2rem;
    flex-wrap: wrap;
  }

  .logo {
    display: inline-flex;
    align-items: center;
  }

  .logo :global(img) {
    width: 200px;
    height: auto;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    min-width: 44px;
    min-height: 44px;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .primary-nav > ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav > ul > li > a {
    text-decoration: none;
    color: var(--color-accent-strong);
    font-weight: 500;
    font-size: 1.0625rem;
    padding: 0.5rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
  }

  .nav-dropdown-trigger > a {
    text-decoration: none;
    color: var(--color-accent-strong);
    font-weight: 500;
    font-size: 1.0625rem;
    padding: 0.5rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown-toggle {
    background: none;
    border: none;
    color: var(--color-accent-strong);
    cursor: pointer;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* The 44px touch target is wider than the caret glyph it wraps, which
       otherwise reads as extra whitespace before the next nav item ("Blog")
       — bigger than the gap between any other two items. Pull the following
       item back in with a negative margin rather than shrinking the hit
       area itself, which must stay at least 44px. */
    margin-right: -0.75rem;
  }

  .nav-dropdown-toggle .caret {
    font-size: 0.7em;
    transition: transform 0.15s ease;
  }

  .nav-dropdown-toggle[aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }

  .nav-dropdown.is-open .nav-dropdown-trigger > a,
  .nav-dropdown.is-open .nav-dropdown-toggle {
    color: var(--color-accent);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border-radius: var(--radius);
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.5rem 0;
    min-width: 220px;
  }

  /* The 0.5rem margin-top above is a deliberate visual gap, but an empty
     margin is unhoverable: a pointer moving straight down from the trigger
     into that gap leaves both the trigger's and the menu's own box, breaking
     :hover/mouseenter before it ever reaches the menu. This transparent
     pseudo-element sits exactly in that gap (same size, no background) so a
     descendant box covers the whole path — the pointer never leaves the
     dropdown while crossing it. */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -0.5rem;
    height: 0.5rem;
  }

  .nav-dropdown-menu li a {
    display: block;
    padding: 0.6rem 1.25rem;
    text-decoration: none;
    color: var(--color-text);
    min-height: 44px;
  }

  .nav-dropdown-menu li a:hover {
    background: var(--color-bg-alt);
  }

  /* No CSS-only :focus-within/:hover rule here on purpose: a native <button>
     already fires 'click' on Enter/Space, so the toggle's click handler
     covers keyboard without any extra CSS — and a :focus-within fallback
     actively breaks Escape-to-close, since Escape moves focus back to the
     toggle (by design, for a sighted keyboard user to keep their place),
     which re-satisfies :focus-within and forces the menu back open via CSS
     the instant JS just closed it. One state (aria-expanded/hidden), set
     only by JS, avoids that fight. Mouse hover is handled by the
     mouseenter/mouseleave listeners below, with a close delay. */

  .nav-dropdown-menu[hidden] {
    display: none;
  }

  .nav-cta {
    white-space: nowrap;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .primary-nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--color-bg-alt);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.5rem 1.5rem;
    }

    .primary-nav.is-open {
      display: flex;
    }

    .primary-nav > ul {
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav-dropdown-trigger {
      justify-content: space-between;
      width: 100%;
    }

    .nav-dropdown-menu {
      position: static;
      box-shadow: none;
      padding-left: 1rem;
    }
  }
</style>
