---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from './ServiceCard.astro';
import ValueTile from './ValueTile.astro';
import QuoteStack from './QuoteStack.astro';
import BlogTeaserCard from './BlogTeaserCard.astro';
import CtaBand from './CtaBand.astro';
import { getSiteContent, type Locale } from '../i18n/utils';
import heroImage from '../assets/hero/granatapfel-fruchtbarkeit.png';
import founderPhoto from '../assets/founder/marina-portrait.png';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const s = await getSiteContent(locale);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const localePosts = allPosts.filter((p) => p.id.startsWith(`${locale}/`));
const usingFallback = localePosts.length === 0 && locale !== 'de';
const posts = (usingFallback ? allPosts.filter((p) => p.id.startsWith('de/')) : localePosts)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const serviceTones = ['teal-dark', 'teal', 'sage'] as const;
---

<BaseLayout
  locale={locale}
  path={path}
  title={s.meta.title}
  description={s.meta.description}
  availableLocales={['de', 'en', 'it']}
>
  <!-- Hero: the image column deliberately bleeds to the viewport edge
       (no .container) while the text column keeps the site's usual left
       gutter, matching the original's full-width hero row. -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy reveal reveal-left">
        <h1 class="hero-headline heading-black">{s.hero.headline}</h1>
        {s.hero.paragraphs.map((p) => <p>{p}</p>)}
        <a href={s.hero.ctaHref} class="button button-primary button-hero">{s.hero.cta}</a>
      </div>
      <div class="hero-image reveal reveal-right">
        <Image
          src={heroImage}
          alt="Aufgeschnittener Granatapfel — Symbol des Persephone-Mythos"
          width={1600}
          height={882}
        />
      </div>
    </div>
  </section>

  <!-- Pain points — LAUF-2026-09-10.md A4: live alternates section
       backgrounds dunkel(#f3ece6)/hell(#fbf8f5)/dunkel/hell/dunkel, starting
       right after the Kopfleiste+Hero band (itself already dunkel). This
       was section-alt (dunkel) here, making two dunkel sections in a row
       with the hero above it — dropped so it falls back to the page's own
       hell background instead, matching "1" in the measured table. -->
  <section class="section section-centered">
    <div class="container section-narrow">
      <span class="eyebrow">{s.painPoints.eyebrow}</span>
      <h2 set:html={s.painPoints.heading} />
      {s.painPoints.paragraphs.map((p) => <p>{p}</p>)}
      <QuoteStack quotes={s.painPoints.quotes} />
      <p>{s.painPoints.closing}</p>
    </div>
  </section>

  <!-- Services — A4: "2" in the alternation, dunkel. -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">{s.services.eyebrow}</span>
        <p class="services-lede" set:html={s.services.heading} />
      </div>
      <div class="service-grid">
        {
          s.services.items.map((item, i) => (
            <ServiceCard
              title={item.title}
              description={item.description}
              href={item.href}
              cta={item.cta}
              tone={serviceTones[i % serviceTones.length]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Philosophy — A4: "3" in the alternation, hell. -->
  <section class="section">
    <div class="container philosophy-grid narrow">
      <div class="philosophy-copy">
        <span class="eyebrow">{s.philosophy.eyebrow}</span>
        <h2>{s.philosophy.heading}</h2>
        <div class="philosophy-paragraphs">
          {s.philosophy.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="value-list">
        {s.philosophy.values.map((v) => <ValueTile title={v.title} description={v.description} />)}
      </div>
    </div>
  </section>

  <!-- Founder — A4: "4" in the alternation, dunkel. Blog teasers below
       keeps its plain "section" (hell), continuing the alternation — it
       isn't in the live table (not present on the live page in this
       exact form) but keeping it in step avoids landing back-to-back with
       Founder's dunkel. -->
  <section class="section section-alt founder">
    <div class="container founder-grid">
      <div>
        <span class="eyebrow">{s.founder.eyebrow}</span>
        <h2>{s.founder.heading}</h2>
        {s.founder.paragraphs.map((p) => <p>{p}</p>)}
        <a href={s.founder.href} class="button button-primary">{s.founder.cta}</a>
      </div>
      <div class="founder-photo">
        <Image src={founderPhoto} alt={s.founder.imageAlt} width={700} height={933} />
      </div>
    </div>
  </section>

  <!-- Blog teasers -->
  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          {usingFallback && <p class="blog-fallback-notice">{s.common.blogFallbackNotice}</p>}
          <div class="blog-grid">
            {posts.map((post) => (
              <BlogTeaserCard
                href={`${usingFallback ? '' : locale === 'de' ? '' : `/${locale}`}/blog/${post.id.split('/').slice(1).join('/')}/`}
                title={post.data.title}
                category={post.data.category}
                heroImage={post.data.heroImage}
                heroImageAlt={post.data.heroImageAlt}
                readMoreLabel={s.common.readMore}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Newsletter CTA -->
  <CtaBand
    eyebrow={s.newsletter.eyebrow}
    heading={s.newsletter.heading}
    paragraphs={s.newsletter.paragraphs}
    ctaLabel={s.newsletter.cta}
    ctaHref={s.newsletter.ctaHref}
  />
</BaseLayout>

<style>
  /* .hero/.hero-grid/.hero-copy/.hero-headline/.hero-image now live in
     global.css — Über uns's masthead reuses the exact same split-hero
     pattern, so it has to be a real shared class, not scoped here. See
     CLAUDE.md's "reuse before you build" rule and global.css's own comment
     on this block for why. */

  /* VERGLEICH-2026-09-07.md B1: live is a 25px paragraph, not a heading —
     downgraded from <h2> above; this is its own measured size, not the
     20px body default (NACHTLAUF-2026-09-08.md B1). */
  .services-lede {
    font-size: 1.5625rem;
  }

  /* .service-grid now lives in global.css (NACHTLAUF-2026-09-09.md E3) —
     Über uns's Beratung/Workshops teasers reuse it too. */

  .philosophy-grid,
  .founder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  /* LAUF-2026-09-10.md A1/Punkt 3: "diese Absätze auf der Home sollen auf
     der gleichen Ebene enden" — the philosophy copy column and the
     value-list column must end at the same height, not just share a row.
     align-items:center (above) only centers the shorter column within the
     row, so its bottom edge floats above the taller one's; stretch makes
     both columns the full row height, and the copy column's own
     space-between (below, ≥900px only — see .philosophy-copy) spreads its
     paragraphs to fill that height so its last line lands level with the
     value-list's last line, not just its box. Grid-based, not a measured
     pixel value, so it keeps holding if the copy length changes. Scoped to
     .philosophy-grid only — .founder-grid (photo + text) still wants its
     content vertically centered, not stretched. */
  .philosophy-grid {
    align-items: stretch;
  }

  .narrow {
    /* LAUF-2026-09-10.md A1: was 62rem (992px) — narrower than the ~1200px
       live measure, and the direct cause of point 3's mismatched column
       heights below (a narrower box wraps the copy column onto more
       lines than the live page, throwing off the height match against
       .value-list). Raised past .container's own usable width (1168px at
       desktop) so that governs instead, same fix as .section-narrow in
       global.css. */
    max-width: 1200px;
    margin-inline: auto;
  }

  /* NACHTLAUF-2026-09-09.md E5's original fix for this (extra fixed
     margin-bottom, hand-tuned to the old 992px-wide column) is superseded
     by LAUF-2026-09-10.md A1/Punkt 3's flex-based version above: raising
     .narrow to 1200px reflows this copy onto fewer, longer lines, which
     would have thrown E5's fixed value off again. The looser line-height
     stays (its own readability merit); the fixed margin-bottom is gone —
     .philosophy-paragraphs' space-between (in the ≥900px block below) now
     owns the between-paragraph gap, self-adjusting to whatever height
     .value-list ends up at instead of a re-measured constant. */
  .philosophy-copy p {
    line-height: 1.85;
    margin-bottom: 1.5em;
  }

  /* "Gründerinnen-Überschrift" — VERGLEICH-2026-09-07.md A1: live 36px,
     a size this one heading takes on its own, not shared with the generic
     h2 scale (28px section headings elsewhere use h3, not this). */
  .founder h2 {
    font-size: 2.25rem;
  }

  .founder-photo img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .blog-grid {
    display: grid;
    gap: 1.5rem;
  }

  .blog-fallback-notice {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 900px) {
    .philosophy-grid,
    .founder-grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Only at this breakpoint does .philosophy-copy actually sit beside
       .value-list as a column with its own row-height to fill — below it,
       the two stack and there's nothing to distribute space-between.
       Flexing .philosophy-copy itself lets .philosophy-paragraphs grow to
       fill the leftover height below the eyebrow+heading; flexing THAT
       (not .philosophy-copy) with space-between is what actually spreads
       just the three paragraphs — eyebrow and heading stay put at the
       top, unaffected. */
    .philosophy-copy {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .philosophy-paragraphs {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* space-between owns the gap here — a fixed margin-bottom on top of
       it would just add to it and risk overshooting .value-list's
       height. */
    .philosophy-paragraphs p {
      margin-bottom: 0;
    }

    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
