---
// Shared inline-SVG icon set (docs/RUN-2026-09-07.md Phase B2 / FIXES-2026-09-07.md
// task 2d.4) — used by Beratung, Workshops and Selbsthilfegruppe wherever the live
// site shows a functional icon (section icons, list markers, badge pins, meeting
// details). These are functional UI glyphs, not brand marks, so a simple
// hand-drawn/open equivalent stands in for the live site's Avada icon-font glyphs —
// no icon font or new dependency was added; see DESIGN-SYSTEM.md's "Icon set"
// section for the record of this choice.
//
// Every icon shares a 24×24 viewBox, stroke-based, currentColor — so it inherits
// whatever color/size the wrapping element sets, the same way a font-icon would.
export type IconName =
  | 'book'
  | 'scroll'
  | 'pin'
  | 'calendar'
  | 'clock'
  | 'shield'
  | 'heart'
  | 'group'
  | 'check'
  | 'plus';

interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 24 } = Astro.props;

// NACHTLAUF-2026-09-08.md A2: the Selbsthilfegruppe meeting-detail icons
// measured too fine to read at their small circle size — thickened every
// glyph's stroke (1.5 -> 2, check stays a touch heavier at 2.5 since a
// checkmark reads thin fastest).
const strokeWidth = name === 'check' ? 2.5 : 2;

const paths: Record<IconName, string> = {
  // Open book — Workshops & Trainings card icon and its list-marker
  // (NACHTLAUF-2026-09-08.md A2/A3: redrawn with page-lines so it reads as
  // a book rather than an abstract fan shape at both the 28px section-icon
  // size and the 16px list-marker size).
  book:
    'M12 6.7c-1.7-1.4-3.9-2-6-2a1 1 0 0 0-1 1v11.2a1 1 0 0 0 1 1c2.1 0 4.3.6 6 2 1.7-1.4 3.9-2 6-2a1 1 0 0 0 1-1V5.7a1 1 0 0 0-1-1c-2.1 0-4.3.6-6 2Z ' +
    'M12 6.7v12.2 M7.5 9h2.8 M7.5 11.8h2.8 M13.7 9h2.8 M13.7 11.8h2.8',
  // Scroll — Ressourcen card icon and its list-marker (NACHTLAUF-2026-09-08.md
  // A2/A3: replaces the earlier folded-corner "document" glyph, which the
  // feedback found not recognizable; a rolled parchment — curled top and
  // bottom edges around two lines of "text" — reads as a scroll at both the
  // 28px section-icon size and the 16px list-marker size).
  scroll:
    'M6 5.5c0-1 2.7-1.5 6-1.5s6 .5 6 1.5-2.7 1.5-6 1.5-6-.5-6-1.5Z ' +
    'M6 5.5v12.5 M18 5.5v12.5 ' +
    'M6 18c0-1 2.7-1.5 6-1.5s6 .5 6 1.5-2.7 1.5-6 1.5-6-.5-6-1.5Z ' +
    'M9 10h6 M9 14h6',
  // Pin — badge/pill location icon, meeting-details card.
  pin: 'M12 21s6.5-6.02 6.5-11A6.5 6.5 0 0 0 5.5 10c0 4.98 6.5 11 6.5 11Z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  // Calendar — meeting-details date.
  calendar: 'M4.5 6.5h15v13.5h-15V6.5Z M4.5 10h15 M8 4v3.5 M16 4v3.5 M8 13.5h2.5 M13.5 13.5H16',
  // Clock — meeting-details time.
  clock: 'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17Z M12 7.5V12l3 2',
  // Shield — Verschwiegenheit principle.
  shield: 'M12 3.5 19 6.5v5c0 5-3 8.2-7 9.5-4-1.3-7-4.5-7-9.5v-5L12 3.5Z',
  // Heart — Respekt principle.
  heart: 'M12 20s-7-4.35-9-8.5C1.6 8.4 3.2 5.5 6.2 5.5c1.9 0 3.4 1 4.8 2.7C12.4 6.5 13.9 5.5 15.8 5.5c3 0 4.6 2.9 3.2 6-2 4.15-9 8.5-9 8.5Z',
  // Group of people — Peer-Support principle.
  group: 'M8.5 11a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5Z M15.5 11a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5Z M3 19c.4-2.8 2.5-4.5 5.5-4.5s5.1 1.7 5.5 4.5 M12 19c.4-2.8 2.5-4.5 5.5-4.5.9 0 1.7.15 2.5.5',
  // Check — Beratung/Selbsthilfegruppe list-item marker.
  check: 'm5 12.5 4.5 4.5L19 7.5',
  // Plus — accordion toggle (Beratung's "Gut zu wissen", FAQs). Rotates
  // 45° to read as a close/"x" affordance when its <details> is open.
  plus: 'M12 5v14 M5 12h14',
};
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
