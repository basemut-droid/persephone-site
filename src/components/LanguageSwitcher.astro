---
import { locales, localeNames, localizedPath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  path: string;
  label: string;
}
const { locale, path, label } = Astro.props;
---

<details class="lang-switcher">
  <summary aria-label={label}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.5 4 5.6 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.6-4-9s1.5-6.5 4-9Z" />
    </svg>
    <span>{locale.toUpperCase()}</span>
  </summary>
  <ul>
    {
      locales.map((loc) => (
        <li>
          <a
            href={localizedPath(path, loc)}
            aria-current={loc === locale ? 'page' : undefined}
            hreflang={loc}
            lang={loc}
          >
            {localeNames[loc]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-switcher summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .lang-switcher summary::-webkit-details-marker {
    display: none;
  }

  .lang-switcher[open] summary {
    color: var(--color-accent);
  }

  .lang-switcher ul {
    position: absolute;
    top: 100%;
    right: 0;
    margin: 0.5rem 0 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--color-surface);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border-radius: var(--radius);
    min-width: 160px;
    z-index: 10;
  }

  .lang-switcher li a {
    display: block;
    padding: 0.6rem 1.25rem;
    text-decoration: none;
    color: var(--color-text);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .lang-switcher li a:hover {
    background: var(--color-bg-alt);
  }

  .lang-switcher li a[aria-current='page'] {
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .lang-switcher ul {
      position: static;
      box-shadow: none;
      margin-top: 0.25rem;
    }
  }
</style>
