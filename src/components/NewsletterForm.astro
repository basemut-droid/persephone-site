---
// Reusable newsletter signup — drop this on the future /newsletter/ page and
// on event landing pages alike. Not yet wired to a real provider: see the
// TODO below. Whichever provider you pick (Mailchimp, Brevo, ...) handles
// double opt-in itself once the form posts to their API/embed endpoint, so
// no extra work is needed here for that requirement beyond swapping the
// action URL and any hidden fields the provider requires.
interface Props {
  emailLabel: string;
  submitLabel: string;
}
const { emailLabel, submitLabel } = Astro.props;
---

<!--
  TODO(newsletter provider): replace action="#" below with the provider's
  form endpoint, and add any hidden fields it requires (Mailchimp needs
  hidden `u`/`id` fields, Brevo a hidden `email_address_check` field, etc.
  — copy them from the provider's own embed-form snippet).
-->
<form class="newsletter-form" method="post" action="#" novalidate>
  <div class="field">
    <label for="newsletter-email">{emailLabel}</label>
    <input id="newsletter-email" name="email" type="email" required autocomplete="email" />
  </div>

  {/* Honeypot: hidden from sighted/keyboard users, but bots that
      auto-fill every field will trip it. Server-side handling (once a
      provider/back end is wired) should silently reject submissions
      where this field is non-empty. */}
  <div class="field honeypot" aria-hidden="true">
    <label for="newsletter-website">Website</label>
    <input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="button button-primary">{submitLabel}</button>
</form>

<style>
  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .field input {
    padding: 0.7rem 1rem;
    border-radius: var(--radius);
    border: 1px solid rgba(24, 26, 43, 0.25);
    font: inherit;
    min-height: 44px;
    min-width: 240px;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
