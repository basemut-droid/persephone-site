---
// The shared sage-green pill badge (docs/RUN-2026-09-07.md Phase B3 /
// FIXES-2026-09-07.md tasks 2c.1 and 2d.3). Beratung's duration/location
// badges ("50 MINUTEN", "WIEN, ONLINE") and Workshops' location tags
// ("WIEN, GRAZ, ONLINE", "ONLINE") both render through this one component
// instead of two near-identical hand-rolled versions — see FIXES-2026-09-07.md
// for why those two are the same shape despite one being missing content
// and the other only missing styling.
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface Props {
  text: string;
  icon?: IconName;
}
const { text, icon } = Astro.props;
---

<span class="pill">
  {icon && <Icon name={icon} size={14} />}
  {text}
</span>

<style>
  .pill {
    /* Measured directly off Beratung's live raw HTML (inline styles on its
       badge <span>s, RUN-2026-09-07.md Phase D1): sage background, an
       off-white (not near-black) text color, italic, and var(--radius) —
       a rounded rectangle, not a full stadium pill despite the common name
       for this shape. */
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-sage);
    color: var(--color-bg);
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
    font-size: 0.75rem;
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }
</style>
