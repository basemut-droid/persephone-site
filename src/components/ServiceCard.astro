---
interface Props {
  title: string;
  description: string;
  href: string;
  cta: string;
  tone: 'sage' | 'teal' | 'teal-dark';
}
const { title, description, href, cta, tone } = Astro.props;
---

<article class:list={['service-card', `tone-${tone}`]}>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a href={href} class="button button-outline card-cta">{cta}</a>
</article>

<style>
  .service-card {
    position: relative;
    overflow: hidden;
    padding: 2.25rem;
    border-radius: var(--radius);
    color: var(--color-text-on-accent);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Decorative pomegranate-seed texture, matching the live site's own
     card background image — a scattered cluster tucked in one corner. */
  .service-card::after {
    content: '';
    position: absolute;
    inset: auto -20px -20px auto;
    width: 180px;
    height: 180px;
    background: url('/textures/seed-texture.svg') no-repeat center / contain;
    opacity: 0.9;
    pointer-events: none;
  }

  .service-card h3,
  .service-card p,
  .service-card .card-cta {
    position: relative;
    z-index: 1;
  }

  .service-card h3 {
    margin: 0;
  }

  .service-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* PRUEFUNG-B1.md #1: this used to be its own ".card-button" class with a
     stale 12px/italic style that the Phase 1.3 button rework never reached
     — two classes for the same kind of button was exactly why one of them
     got missed. Dissolved into the shared .button.button-outline (already
     correct: 17px, upright, r 4px, bg-alt fill, teal text); only the
     card's own layout (bottom-aligned in the flex column, above the
     decorative corner texture) stays as a local modifier. */
  .card-cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .tone-teal-dark {
    background: linear-gradient(to right, var(--color-teal-dark), var(--color-teal));
  }

  .tone-teal {
    background: linear-gradient(to right, var(--color-teal), var(--color-sage));
  }

  .tone-sage {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-sage) 60%, var(--color-teal-dark) 40%),
      var(--color-sage)
    );
    color: var(--color-text-on-accent);
  }
</style>
