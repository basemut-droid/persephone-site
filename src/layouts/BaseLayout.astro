---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/500-italic.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/dm-sans/900.css';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DraftNotice from '../components/DraftNotice.astro';
import type { Locale } from '../i18n/utils';
import { getSiteContent, locales } from '../i18n/utils';

interface Props {
  locale: Locale;
  path: string; // current pathname, e.g. "/", "/blog/", "/en/blog/"
  title?: string;
  description?: string;
  // NIGHT-RUN.md Phase 4.4: which locales actually have a translation of
  // THIS page (not just the site in general) — defaults to just the
  // current one, since every standalone page except the homepage is
  // German-only. Drives both the visible language switcher (via Header)
  // and the hreflang <link> tags below; before this, both unconditionally
  // advertised all three configured locales regardless of whether a
  // translation existed, so search engines and visitors alike were
  // pointed at pages that 404 (external-review.md's "CONFIRMED
  // PRE-EXISTING" item, OPEN-QUESTIONS.md #12).
  availableLocales?: readonly Locale[];
}

const { locale, path, title, description, availableLocales = [locale] } = Astro.props;
const site = await getSiteContent(locale);
const pageTitle = title ?? site.meta.title;
// NIGHT-RUN.md Phase 3.8 / external-review.md finding #5: this used to
// fall back to the homepage's own description (`site.meta.description`)
// whenever a page didn't pass one, so eleven unrelated pages all shipped
// the same text — worse for search engines than having none. Every page
// now either passes its own real description or ships none; see
// OPEN-QUESTIONS.md for the list still waiting on the owner to write one.
const pageDescription = description;
const canonicalUrl = getAbsoluteLocaleUrl(locale, path);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    {
      /* FIXES-2026-09-07.md task 4: EN/IT are unreviewed, machine-translated
         content — a legal problem, not a cosmetic one, since the English
         homepage was found to drop the owner's required training-status
         disclosure entirely. Not indexable until she's read every sentence
         describing her qualifications. Paired with astro.config.mjs's
         sitemap `filter`, which excludes these locales from the sitemap
         too. */
      locale !== 'de' && <meta name="robots" content="noindex, follow" />
    }
    <link rel="canonical" href={canonicalUrl} />

    {/* hreflang: one tag per language plus x-default, so search engines
        connect the three versions of this page instead of treating them
        as duplicate or unrelated content. */}
    {
      locales
        .filter((loc) => availableLocales.includes(loc))
        .map((loc) => (
          <link rel="alternate" hreflang={loc} href={getAbsoluteLocaleUrl(loc, path.replace(/^\/(en|it)(\/|$)/, '/'))} />
        ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('de', path.replace(/^\/(en|it)(\/|$)/, '/'))} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'Persephone',
      url: getAbsoluteLocaleUrl('de', '/'),
      description: 'Psychosoziale Beratung, Workshops und Selbsthilfegruppe bei unerfülltem Kinderwunsch in Wien, Graz und online.',
      areaServed: ['Wien', 'Graz', 'Online'],
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">{site.common.skipToContent}</a>
    {site.reviewStatus === 'ai-draft' && <DraftNotice text={site.common.draftNotice} />}
    <Header
      locale={locale}
      path={path}
      nav={site.nav}
      switcherLabel={site.common.languageSwitcherLabel}
      availableLocales={availableLocales}
    />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} footer={site.footer} />
  </body>
</html>
