---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import mg7425 from '../assets/pages/angebote/mg-7425.jpg';
import logoGeborgenheit from '../assets/pages/angebote/logo-geborgenheit.png';
import { parseMarkdownBlocks, paragraphs, BlockTracker } from '../lib/parseMarkdownBlocks';

// Live page has no split-hero image (confirmed: its masthead row has no
// --awb-bg-image, unlike Über uns) — a plain PageHero banner is the right
// fit here, matching the rest of the subpages.
const entry = await getEntry('pages', 'de/angebote');
if (!entry) throw new Error('Content collection entry "pages/de/angebote" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

const { eyebrow: heroEyebrow, title: heroTitle, intro: heroIntro } = tracker.heroFields(entry.data.title);
const introPara2 = tracker.at(3);

// The self-recognition list (external-review.md finding #2) is the whole
// point of this page and was missing entirely from the content collection
// — re-extracted from the live page's raw HTML (curled directly, not via a
// summarizing fetch) on 2026-09-06 and confirmed to match
// docs/external-review.md's own verified list exactly, item for item.
//
// On the live page these ten statements are buttons in a client-side
// "services selector" quiz: clicking one fills in a recommendation card
// (title/description/link to one specific offering) via JavaScript with no
// server-rendered fallback content — the card's fields are empty in the
// page's static HTML. Reproducing that quiz would mean inventing which
// offering each of the ten statements maps to, which nothing in the source
// supports; NIGHT-RUN.md's brief is "restore the lost content," not
// "rebuild the interactive selector," so this renders the ten statements
// as a plain list (still the page's real self-recognition device) and logs
// the interactive quiz itself as an open question rather than guessing at
// its logic — see OPEN-QUESTIONS.md.
const recognition = tracker.section('Fang einfach dort an, wo Du Dich wiedererkennst');
const recognitionList = recognition.find((b) => b.type === 'list');
if (!recognitionList || recognitionList.type !== 'list') throw new Error('Expected the self-recognition list');
// "Das könnte jetzt passen" is that same quiz's result-card eyebrow on the
// live page (see above) — real copy, but with no fixed content of its own
// to follow, since its actual content is chosen per click. Placed here as
// the eyebrow introducing the next-step block that already exists in the
// static content, rather than dropped or left to float with nothing under
// it.
const passtEyebrow = paragraphs(recognition)[0];
const nextStepHeading = recognition.find((b) => b.type === 'heading' && b.level === 3);
if (!nextStepHeading || nextStepHeading.type !== 'heading') throw new Error('Expected the "Wenn sich..." sub-heading');
const nextStepIntro = paragraphs(recognition)[1];
const cta = recognition.find((b) => b.type === 'cta');
if (!cta || cta.type !== 'cta') throw new Error('Expected a CTA in the Angebote body');

// Source links to https://www.persephone.at/termine/ (a real, working live
// page) — rewritten to this site's own local route rather than left as an
// absolute persephone.at URL, per docs/content-audit.md's carry-forward note.
const ctaHref = cta.href.replace(/^https?:\/\/(www\.)?persephone\.at/, '');

tracker.exclude(tracker.at(10), 'portrait photo, rendered via static import below');
tracker.exclude(tracker.at(11), 'badge logo, rendered via static import below');
tracker.assertAllHandled('angebote.astro');
---

<BaseLayout locale="de" path="/angebote/" title={`${entry.data.title} – Persephone`}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  <section class="section section-centered">
    <div class="container section-narrow">
      {introPara2.type === 'paragraph' && <p>{introPara2.text}</p>}

      <h2>Fang einfach dort an, wo Du Dich wiedererkennst</h2>
      <ul class="recognition-list">
        {recognitionList.items.map((item) => <li>{item}</li>)}
      </ul>

      {passtEyebrow && <span class="eyebrow">{passtEyebrow}</span>}
      <h3>{nextStepHeading.text}</h3>
      {nextStepIntro && <p>{nextStepIntro}</p>}
      <a href={ctaHref} class="button button-primary">{cta.text}</a>
      <div class="supporting-image">
        <Image src={mg7425} alt="" width={300} height={450} />
      </div>
      <Image class="badge" src={logoGeborgenheit} alt="" width={90} height={90} />
    </div>
  </section>
</BaseLayout>

<style>
  .recognition-list {
    text-align: left;
    max-width: 40rem;
    margin: 2rem auto;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .recognition-list li {
    border-left: 3px solid var(--color-accent-strong);
    padding-left: 1rem;
  }

  .supporting-image {
    margin-top: 2rem;
  }

  .supporting-image img {
    margin-inline: auto;
    border-radius: var(--radius);
  }

  .badge {
    margin-top: 1rem;
    border-radius: var(--radius);
  }
</style>
