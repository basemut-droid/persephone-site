---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import mg7425 from '../assets/pages/angebote/mg-7425.jpg';
import logoGeborgenheit from '../assets/pages/angebote/logo-geborgenheit.png';
import { parseMarkdownBlocks, section, paragraphs } from '../lib/parseMarkdownBlocks';

// Live page has no split-hero image (confirmed: its masthead row has no
// --awb-bg-image, unlike Über uns) — a plain PageHero banner is the right
// fit here, matching the rest of the subpages.
const entry = await getEntry('pages', 'de/angebote');
if (!entry) throw new Error('Content collection entry "pages/de/angebote" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');

const heroEyebrow = (blocks[0].type === 'paragraph' && blocks[0].text) || undefined;
const heroTitle = blocks[1].type === 'heading' ? blocks[1].text : entry.data.title;
const heroIntro = (blocks[2].type === 'paragraph' && blocks[2].text) || undefined;

// The rest of the body (from the second paragraph on) is one continuous
// centered section on the live page — same .section-centered/.section-narrow
// pattern already used by the homepage's pain-points section and Über uns's
// narrative section, not a new layout.
const rest = blocks.slice(3).filter((b) => b.type !== 'image'); // images placed explicitly below
const restParagraphs = paragraphs(rest);
const subHeading = rest.find((b) => b.type === 'heading' && b.level === 2);
const subSubHeading = rest.find((b) => b.type === 'heading' && b.level === 3);
const cta = rest.find((b) => b.type === 'cta');
if (!cta || cta.type !== 'cta') throw new Error('Expected a CTA in the Angebote body');

// Source links to https://www.persephone.at/termine/ (a real, working live
// page) — rewritten to this site's own local route rather than left as an
// absolute persephone.at URL, per docs/content-audit.md's carry-forward note.
const ctaHref = cta.href.replace(/^https?:\/\/(www\.)?persephone\.at/, '');
---

<BaseLayout locale="de" path="/angebote/" title={`${entry.data.title} – Persephone`}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  <section class="section section-centered">
    <div class="container section-narrow">
      {restParagraphs[0] && <p>{restParagraphs[0]}</p>}
      {subHeading?.type === 'heading' && <h2>{subHeading.text}</h2>}
      {subSubHeading?.type === 'heading' && <h3>{subSubHeading.text}</h3>}
      {restParagraphs.slice(1).map((p) => <p>{p}</p>)}
      <a href={ctaHref} class="button button-primary">{cta.text}</a>
      <div class="supporting-image">
        <Image src={mg7425} alt="" width={300} height={450} />
      </div>
      <Image class="badge" src={logoGeborgenheit} alt="" width={90} height={90} />
    </div>
  </section>
</BaseLayout>

<style>
  .supporting-image {
    margin-top: 2rem;
  }

  .supporting-image img {
    margin-inline: auto;
    border-radius: var(--radius);
  }

  .badge {
    margin-top: 1rem;
    border-radius: var(--radius);
  }
</style>
