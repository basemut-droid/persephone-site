---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCta from '../components/ClosingCta.astro';
import mg7425 from '../assets/pages/angebote/mg-7425.jpg';
import logoGeborgenheit from '../assets/pages/angebote/logo-geborgenheit.png';
import { parseMarkdownBlocks, BlockTracker } from '../lib/parseMarkdownBlocks';

// Corrected 2026-09-07 (RUN Phase E): the live masthead DOES have a split
// hero image (--awb-bg-image: Hintergrund.jpg — the same pomegranate
// illustration as the homepage). An earlier comment here claiming otherwise
// was wrong; see docs/external-review.md's correction and
// FIXES-2026-09-07.md task 2. PageHero now defaults to that image.
const entry = await getEntry('pages', 'de/angebote');
if (!entry) throw new Error('Content collection entry "pages/de/angebote" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

const { eyebrow: heroEyebrow, title: heroTitle, intro: heroIntro } = tracker.heroFields(entry.data.title);
// LAUF-2026-09-10.md B8 Punkt 24: this paragraph used to render right
// above the "Fang einfach dort an..." H2 — Marina asked for it gone,
// matching the live original. Still claimed via .at() (not silently
// dropped from the tracker's accounting), just not rendered.
tracker.exclude(tracker.at(3), 'B8 Punkt 24: intro paragraph before the H2, removed per Marina + live original');

// The self-recognition selector (external-review.md finding #2 /
// FIXES-2026-09-07.md task 2b.1) is the whole point of this page. The ten
// statements themselves survived extraction as a plain list; the response
// text and offer recommendation per statement did not, because an earlier
// session assumed the client-side "services selector" script had no
// server-rendered data to read — wrong: its data literal (all ten
// statement/response/offer triples, and the three offers' full copy) is
// directly in the live page's raw HTML, re-extracted 2026-09-07 into
// entry.data.recognitionPanel (see content.config.ts and angebote.md's own
// frontmatter comment). The markdown body's old plain list is gone — this
// structured field is now the single source for the statement text too, so
// there's nothing left duplicated between the two places.
const panel = entry.data.recognitionPanel;
if (!panel) throw new Error('Expected entry.data.recognitionPanel on angebote.md');

const recognition = tracker.section('Fang einfach dort an, wo Du Dich wiedererkennst');
const nextStepHeading = recognition.find((b) => b.type === 'heading' && b.level === 3);
if (!nextStepHeading || nextStepHeading.type !== 'heading') throw new Error('Expected the "Wenn sich..." sub-heading');
const nextStepIntro = recognition.find((b) => b.type === 'paragraph');
const cta = recognition.find((b) => b.type === 'cta');
if (!cta || cta.type !== 'cta') throw new Error('Expected a CTA in the Angebote body');

// Source links to https://www.persephone.at/termine/ (a real, working live
// page) — rewritten to this site's own local route rather than left as an
// absolute persephone.at URL, per docs/content-audit.md's carry-forward note.
// C2 (OPEN-QUESTIONS.md #8, decided 2026-09-08): /termine/ -> /kennenlernen/.
const ctaHref = cta.href.replace(/^https?:\/\/(www\.)?persephone\.at/, '').replace('/termine/', '/kennenlernen/');

tracker.exclude(tracker.at(10), 'portrait photo, rendered via static import below');
tracker.exclude(tracker.at(11), 'badge logo, rendered via static import below');
tracker.assertAllHandled('angebote.astro');
---

<BaseLayout locale="de" path="/angebote/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  {/* docs/NACHTRAG-2026-09-11.md N1: the colored-tile/"Button-Kästchen"
     section that used to sit here (LAUF-2026-09-10.md B8 Punkt 19) was
     misfiled — Marina's screenshot for that point actually shows the
     Über-uns cards, not these Beratung/Workshops tiles. Moved to
     ueber-uns.astro; removed here ersatzlos rather than restoring the
     paragraph it had displaced (`introPara2`, B8 Punkt 24 already asked
     for that paragraph gone to match the live original, independent of
     the tiles ever existing) — see N1's report note for the reasoning. */}
  <section class="section section-centered">
    <div class="container">
      <h2 class="eyebrow">Fang einfach dort an, wo Du Dich wiedererkennst</h2>

      {
        /* Accessible tabs/disclosure pattern (FIXES-2026-09-07.md task
           2b.1) built entirely on native radio inputs + labels + CSS — no
           JavaScript at all, so there's no "without JS" fallback case to
           special-case: it simply always works. Keyboard: a native radio
           group is Tab-to-enter, arrow-keys-to-choose, no custom key
           handling needed. Every response panel renders by default
           (.pf-response { display:block }) so a browser that doesn't
           support :has() shows all ten responses stacked — "show all
           responses rather than none" — and only browsers that do support
           it (evergreen Chrome/Firefox/Safari/Edge) get the single-panel
           interactive behavior, gated by @supports so the two states never
           fight each other.

           LAUF-2026-09-10.md B8 Punkt 23: none of the ten radios starts
           checked (was checked={i === 0}) — the initial view is meant to
           show only the statements, full width, no recommendation at all.
           :has(#pf-choice-N:checked) simply matches nothing until a
           statement is clicked, which already gets that for free; the
           small script further down only handles Punkt 25's precise
           vertical alignment, not the show/hide itself. */
      }
      <div class="pf-selector" id="pf-services-selector">
        <div class="pf-selector-grid">
          <div class="pf-recognition-list" role="radiogroup" aria-label="Situationen">
            {
              panel.statements.map((s, i) => (
                <div class="pf-recognition-item">
                  <input type="radio" name="pf-choice" id={`pf-choice-${i}`} class="visually-hidden" />
                  <label for={`pf-choice-${i}`} class="pf-recognition">
                    {s.text}
                  </label>
                </div>
              ))
            }
          </div>

          <div class="pf-response-home">
            {
              panel.statements.map((s, i) => {
                const offer = panel.offers[s.offer];
                return (
                  <div class={`pf-response pf-response-${i}`}>
                    <p class="pf-bridge">{s.bridge}</p>
                    <div class="pf-offer-card">
                      <h3 class="eyebrow pf-offer-eyebrow">Das könnte jetzt passen</h3>
                      <h4 class="pf-offer-title">{offer.title}</h4>
                      <p class="pf-offer-description">{offer.description}</p>
                      <a class="pf-offer-link" href={offer.href}>
                        {offer.cta}
                      </a>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // LAUF-2026-09-10.md B8 Punkt 25: "Die Empfehlung rechts sollte
    // möglichst auf der Ebene des angeklickten Satzes aufgehen... wenn der
    // Satz zu weit unten ist, so, dass der einrahmende Kasten nicht
    // vergrößert werden muss." Pure enhancement on top of the CSS-only
    // radio/:has() mechanism above, which already shows/hides the right
    // response and works without this script — this only fine-tunes WHERE
    // the response card sits: top-aligned with the clicked statement by
    // default, shifted up just far enough that its bottom never passes the
    // last statement's bottom (never taller than the list itself).
    const selector = document.getElementById('pf-services-selector');
    const list = selector?.querySelector<HTMLElement>('.pf-recognition-list');
    const responseHome = selector?.querySelector<HTMLElement>('.pf-response-home');
    if (selector && list && responseHome) {
      const inputs = [...selector.querySelectorAll<HTMLInputElement>('input[name="pf-choice"]')];

      function positionCard() {
        const checked = inputs.find((i) => i.checked);
        const lastItem = list!.lastElementChild as HTMLElement | null;
        if (!checked || !lastItem || !window.matchMedia('(min-width: 900px)').matches) {
          responseHome!.style.marginTop = '';
          return;
        }
        const item = checked.closest<HTMLElement>('.pf-recognition-item');
        if (!item) return;
        const listTop = list!.getBoundingClientRect().top;
        const desiredTop = item.getBoundingClientRect().top - listTop;
        const maxBottom = lastItem.getBoundingClientRect().bottom - listTop;
        const cardHeight = responseHome!.offsetHeight;
        const top = Math.max(0, Math.min(desiredTop, maxBottom - cardHeight));
        responseHome!.style.marginTop = `${top}px`;
      }

      inputs.forEach((input) => input.addEventListener('change', () => positionCard()));
      window.addEventListener('resize', positionCard);
      positionCard();
    }
  </script>

  {/* LAUF-2026-09-10.md B8 Punkt 30: layout="pair" (equal squares, no
     overlap) is removed — Marina's fresh screenshot shows the live page's
     photo and logo overlapping, reversing NACHTLAUF-2026-09-08.md B3's
     earlier "confirmed non-overlap" finding for this specific page.
     Defaults back to the component's own "overlap" layout. */}
  <ClosingCta
    heading={nextStepHeading.text}
    paragraphs={nextStepIntro?.type === 'paragraph' ? [nextStepIntro.text] : []}
    ctaLabel={cta.text}
    ctaHref={ctaHref}
    portrait={mg7425}
    portraitAlt="Porträtfoto von Marina Bletsas, Gründerin von Persephone"
    tile={logoGeborgenheit}
    tileAlt=""
  />
</BaseLayout>

<style>
  .pf-selector {
    background: var(--color-bg-alt);
    border-radius: 1.125rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    margin-top: 2.5rem;
    text-align: left;
  }

  .pf-selector-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .pf-recognition-list {
    display: flex;
    flex-direction: column;
  }

  .pf-recognition-item {
    position: relative;
  }

  .pf-recognition {
    display: block;
    width: 100%;
    padding: 0.9rem 0.75rem 0.9rem 1.25rem;
    color: var(--color-accent-strong);
    opacity: 0.68;
    font-size: clamp(1.1rem, 1vw + 0.9rem, 1.3rem);
    font-style: italic;
    line-height: 1.45;
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      color 0.2s ease;
  }

  .pf-recognition::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 3px;
    background: transparent;
    border-radius: 3px;
    transition: background-color 0.2s ease;
  }

  .pf-recognition:hover {
    opacity: 0.9;
  }

  /* Active state — driven by :has() (see the frontmatter comment above),
     one rule per statement since CSS has no way to bind "the Nth radio" to
     "the Nth label" without repeating the index. */
  #pf-services-selector:has(#pf-choice-0:checked) label[for='pf-choice-0'],
  #pf-services-selector:has(#pf-choice-1:checked) label[for='pf-choice-1'],
  #pf-services-selector:has(#pf-choice-2:checked) label[for='pf-choice-2'],
  #pf-services-selector:has(#pf-choice-3:checked) label[for='pf-choice-3'],
  #pf-services-selector:has(#pf-choice-4:checked) label[for='pf-choice-4'],
  #pf-services-selector:has(#pf-choice-5:checked) label[for='pf-choice-5'],
  #pf-services-selector:has(#pf-choice-6:checked) label[for='pf-choice-6'],
  #pf-services-selector:has(#pf-choice-7:checked) label[for='pf-choice-7'],
  #pf-services-selector:has(#pf-choice-8:checked) label[for='pf-choice-8'],
  #pf-services-selector:has(#pf-choice-9:checked) label[for='pf-choice-9'] {
    opacity: 1;
    font-weight: 600;
    font-style: normal;
    transform: translateX(0.3rem);
  }

  #pf-services-selector:has(#pf-choice-0:checked) label[for='pf-choice-0']::before,
  #pf-services-selector:has(#pf-choice-1:checked) label[for='pf-choice-1']::before,
  #pf-services-selector:has(#pf-choice-2:checked) label[for='pf-choice-2']::before,
  #pf-services-selector:has(#pf-choice-3:checked) label[for='pf-choice-3']::before,
  #pf-services-selector:has(#pf-choice-4:checked) label[for='pf-choice-4']::before,
  #pf-services-selector:has(#pf-choice-5:checked) label[for='pf-choice-5']::before,
  #pf-services-selector:has(#pf-choice-6:checked) label[for='pf-choice-6']::before,
  #pf-services-selector:has(#pf-choice-7:checked) label[for='pf-choice-7']::before,
  #pf-services-selector:has(#pf-choice-8:checked) label[for='pf-choice-8']::before,
  #pf-services-selector:has(#pf-choice-9:checked) label[for='pf-choice-9']::before {
    background: var(--color-accent-strong);
  }

  /* Visible focus state for the (visually-hidden) radio input itself —
     the global focus-visible rule targets `input:focus-visible` already,
     but a 1px clipped element needs the ring to land on its label instead
     to actually be seen. */
  .visually-hidden:focus-visible + .pf-recognition {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .pf-response-home {
    min-width: 0;
  }

  /* Fallback: show every response, stacked — the default, unconditional
     state. Only overridden inside @supports below. */
  .pf-response {
    padding-top: 1px; /* avoid margin-collapse making stacked responses touch */
  }

  .pf-response + .pf-response {
    margin-top: 2.5rem;
  }

  .pf-bridge {
    margin: 0 0 1.5rem;
    font-size: clamp(1.05rem, 0.4vw + 0.95rem, 1.15rem);
    font-weight: 500;
    line-height: 1.55;
  }

  .pf-offer-card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-surface);
    border-radius: 1rem;
  }

  .pf-offer-eyebrow {
    margin-bottom: 0.7rem;
  }

  .pf-offer-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 1vw + 1.3rem, 1.85rem);
    font-weight: 600;
  }

  .pf-offer-description {
    margin: 0 0 1.25rem;
    opacity: 0.86;
  }

  .pf-offer-link {
    display: inline-block;
    color: var(--color-accent-strong);
    font-weight: 600;
    text-decoration: none;
    transition:
      color 0.18s ease,
      transform 0.18s ease;
  }

  .pf-offer-link:hover {
    color: var(--color-terracotta-dark);
    transform: translateX(0.2rem);
  }

  /* The interactive single-panel behavior: only in browsers that support
     :has(), so unsupporting browsers keep the "show every response" default
     above instead of showing nothing. */
  @supports selector(:has(a)) {
    .pf-response {
      display: none;
    }

    #pf-services-selector:has(#pf-choice-0:checked) .pf-response-0,
    #pf-services-selector:has(#pf-choice-1:checked) .pf-response-1,
    #pf-services-selector:has(#pf-choice-2:checked) .pf-response-2,
    #pf-services-selector:has(#pf-choice-3:checked) .pf-response-3,
    #pf-services-selector:has(#pf-choice-4:checked) .pf-response-4,
    #pf-services-selector:has(#pf-choice-5:checked) .pf-response-5,
    #pf-services-selector:has(#pf-choice-6:checked) .pf-response-6,
    #pf-services-selector:has(#pf-choice-7:checked) .pf-response-7,
    #pf-services-selector:has(#pf-choice-8:checked) .pf-response-8,
    #pf-services-selector:has(#pf-choice-9:checked) .pf-response-9 {
      display: block;
    }
  }

  /* LAUF-2026-09-10.md B8 Punkt 23: "Die erste Ansicht sollte die
     Wiedererkennungssätze nur anzeigen, und sie sollen die ganze Breite
     des Kastens einnehmen. Erst wenn ich auf einen klicke, soll das
     empfohlene Angebot aufgehen und die Sätze in eine Spalte links
     einrücken." Two columns only once something is actually selected —
     :has() again, same technique the response panels themselves already
     use, so there's no separate JS path for this either. Below this
     selector's own condition, the plain single-column .pf-selector-grid
     rule above still applies (full-width statements, response tucked
     underneath once chosen) — matches "auf schmalen Bildschirmen: eine
     Spalte plus untergeschobene Empfehlung". */
  @media (min-width: 900px) {
    #pf-services-selector:has(input:checked) .pf-selector-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: clamp(3rem, 6vw, 5.5rem);
      align-items: start;
    }

    /* Punkt 25: no more scroll-following ("kein Mitwandern beim
       Scrollen mehr") — position comes from the script's own margin-top
       instead of position:sticky. align-self:start so that margin-top
       actually moves the card down from the top of its grid cell, rather
       than being overridden by grid's default stretch. */
    .pf-response-home {
      align-self: start;
    }
  }
</style>
