---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Pill from '../components/Pill.astro';
import Icon from '../components/Icon.astro';
import marinaPortrait from '../assets/shared/marina-von-persephone.jpg';
import logoEmpathie from '../assets/pages/beratung/logo-empathie.png';
import { parseMarkdownBlocks, paragraphs, parseLinkHeading, BlockTracker } from '../lib/parseMarkdownBlocks';

// Corrected 2026-09-07 (RUN Phase E): the live masthead DOES have a split
// hero image (--awb-bg-image: Hintergrund.jpg — the same pomegranate
// illustration as the homepage). An earlier comment here claiming otherwise
// was wrong; see docs/external-review.md's correction and
// FIXES-2026-09-07.md task 2. PageHero now defaults to that image.
const entry = await getEntry('pages', 'de/beratung');
if (!entry) throw new Error('Content collection entry "pages/de/beratung" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

const { eyebrow: heroEyebrow, title: heroTitle, intro: heroIntro } = tracker.heroFields(entry.data.title);

// "Was ist Beratung?", "Formate", "Einzelberatung", "Paarberatung" are all
// one continuous section on the live page (single row, light background) —
// not four alternating sections. Both "Was ist Beratung?" and "Formate"
// (a heading-only grouping label, no body text of its own) render their
// own heading text now — previously only their contents rendered, which is
// exactly how external-review.md finding #3 lost them: the heading names
// were used to *locate* content but never themselves printed anywhere.
const wasIstBeratung = paragraphs(tracker.section('Was ist Beratung?'));
tracker.section('Formate'); // heading-only grouping label, no body of its own — rendered below, nothing further to extract
const formats = ['Einzelberatung', 'Paarberatung'].map((heading) => {
  const sec = tracker.section(heading);
  return {
    heading,
    intro: paragraphs(sec)[0],
    items: sec.find((b) => b.type === 'list'),
    badges: entry.data.formatBadges?.[heading] ?? [],
  };
});

// "Gut zu wissen" is a real FAQ list (h4 question + paragraph answer, 4
// pairs) — its own section, beige on the live page.
const gutZuWissen = tracker.section('Gut zu wissen');
const faqs: { question: string; answer: string }[] = [];
for (let i = 0; i < gutZuWissen.length; i++) {
  const b = gutZuWissen[i];
  if (b.type === 'heading' && b.level === 4) {
    const next = gutZuWissen[i + 1];
    // Each question is a same-page anchor link on the live site, part of
    // an accordion widget this static rebuild isn't reproducing (no
    // matching #id exists here) — the label is real content, the href
    // isn't, so only the label is kept.
    const question = parseLinkHeading(b.text)?.label ?? b.text;
    faqs.push({ question, answer: next?.type === 'paragraph' ? next.text : '' });
  }
}

const closing = tracker.section('Möchtest Du ein Erstgespräch?');
const closingParagraphs = paragraphs(closing);
const cta = closing.find((b) => b.type === 'cta');
if (!cta || cta.type !== 'cta') throw new Error('Expected a CTA after "Möchtest Du ein Erstgespräch?"');
// C2 (OPEN-QUESTIONS.md #8, decided 2026-09-08): /termine/ -> /kennenlernen/.
const ctaHref = cta.href.replace(/^https?:\/\/(www\.)?persephone\.at/, '').replace('/termine/', '/kennenlernen/');
// The portrait and badge images in this section are already rendered below
// via statically-imported assets (astro:assets needs a static import to
// optimize them, not a path read from content at runtime) — accounted for
// via the .section() call above, not re-rendered from the block data.
tracker.assertAllHandled('beratung.astro');
---

<BaseLayout locale="de" path="/beratung/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  <section class="section">
    <div class="container section-narrow section-centered">
      <h2 class="eyebrow">Was ist Beratung?</h2>
      {wasIstBeratung.map((p) => <p>{p}</p>)}
    </div>
    <div class="container section-centered">
      <h2 class="eyebrow section-heading">Formate</h2>
    </div>
    <div class="container format-grid">
      {
        formats.map((f) => (
          <article class="format-card">
            <h2 class="eyebrow">{f.heading}</h2>
            {f.intro && <p>{f.intro}</p>}
            {/* LAUF-2026-09-10.md B10 Punkt 27: Dauer/Ort move above the
               list, not below it — was margin-top:auto pinning them to the
               card's bottom. */}
            {f.badges.length > 0 && (
              <div class="format-badges">
                {f.badges.map((b) => <Pill text={b} />)}
              </div>
            )}
            {f.items?.type === 'list' && (
              <ul class="icon-list icon-list-check">
                {f.items.items.map((item) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-alt">
    <div class="container section-narrow section-centered">
      <h2 class="eyebrow">Gut zu wissen</h2>
    </div>
    <div class="container section-narrow">
      {
        /* NACHTLAUF-2026-09-08.md B4: live is a collapsed accordion (four
           questions, one open at a time isn't required — plain independent
           <details>, matching how every other disclosure on this site
           already works with no JS), not four permanently-open panels. */
        faqs.map((f) => (
          <details class="accordion-item">
            <summary>
              <span class="icon-circle icon-circle-sm icon-circle-sage accordion-icon">
                <Icon name="plus" size={16} />
              </span>
              <h4>{f.question}</h4>
            </summary>
            <p>{f.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <ClosingCta
    heading="Möchtest Du ein Erstgespräch?"
    paragraphs={closingParagraphs}
    ctaLabel={cta.text}
    ctaHref={ctaHref}
    portrait={marinaPortrait}
    portraitAlt="Porträtfoto von Marina Bletsas, Gründerin von Persephone"
    tile={logoEmpathie}
    tileAlt=""
  />
</BaseLayout>

<style>
  .format-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .format-card {
    /* Live cards sit on the beige surface with no border (FIXES-2026-09-07.md
       task 2c.1) — previously white with an implied thin edge against the
       page's own off-white background. */
    background: var(--color-bg-alt);
    padding: 2rem;
    border-radius: var(--radius);
    /* NACHTLAUF-2026-09-08.md B4/B5: equal-height cards with the location
       badge anchored to the bottom, regardless of how many list items
       precede it (flex column + margin-top: auto on the badge row). */
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .format-card .icon-list {
    margin-top: 1rem;
  }

  .format-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    /* B10 Punkt 27 "Genug breathing Raum lassen" — room above (clears the
       intro paragraph) and below (before the list starts), now that this
       sits between them instead of pinned to the card's bottom edge. */
    margin: 1.5rem 0;
  }

  /* NACHTLAUF-2026-09-08.md B4: the question is its own measured 20px, not
     the browser's inherited default h4 size. */
  .accordion-item summary h4 {
    font-size: 1.25rem;
  }

  @media (min-width: 900px) {
    .format-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }
</style>
