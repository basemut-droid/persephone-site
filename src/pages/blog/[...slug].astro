---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogTeaserCard from '../../components/BlogTeaserCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id, data }) => id.startsWith('de/') && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.split('/').slice(1).join('/') },
    props: { post },
  }));
}

const { post } = Astro.props;

// NACHTLAUF-2026-09-08.md B9 / VERGLEICH-2026-09-07.md B14: live shows
// three related posts at the end of every article. This isn't a live value
// to copy (that would be WordPress's own related-posts plugin, picking
// from *all* posts including the many not yet in this rebuild) — it's
// structure to derive from data already here, per the brief's own
// "aus den Kategorien abgeleitet". Other de/ posts sharing at least one
// category, most shared categories first, then most recent; falls back to
// just "most recent other posts" if fewer than three share a category, so
// this keeps working as more posts are added regardless of overlap.
const allPosts = await getCollection('blog', ({ id, data }) => id.startsWith('de/') && !data.draft);
const others = allPosts.filter((p) => p.id !== post.id);
const postCategories = new Set(post.data.category ?? []);
const related = others
  .map((p) => ({ post: p, shared: (p.data.category ?? []).filter((c) => postCategories.has(c)).length }))
  .sort((a, b) => b.shared - a.shared || b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf())
  .slice(0, 3)
  .map((r) => r.post);
// Two posts link to persephone.at URLs that are live 404s (stale slugs --
// see OPEN-QUESTIONS.md #6). Fixed in astro.config.mjs's remarkFixDeadLinks
// plugin, not here -- render() reads a pre-rendered HTML cache rather than
// the raw body at request time, so a render-time string patch (what every
// other page's dead-link fix does) silently has no effect for content
// rendered via <Content />; the markdown-to-HTML compile step is the only
// point left to intervene.
const { Content } = await render(post);
const dateLabel = post.data.publishDate.toLocaleDateString('de-AT', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// updatedDate exists on the schema but no post had set it and nothing
// rendered it — a real gap the build-check's new unused-schema-field rule
// (RUN-2026-09-07.md Phase F task 6) would have caught. Closed rather than
// allow-listed away, since a post that IS later updated should say so.
const updatedLabel = post.data.updatedDate?.toLocaleDateString('de-AT', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  locale="de"
  path={`/blog/${post.id.split('/').slice(1).join('/')}/`}
  title={post.data.seoTitle ?? `${post.data.title} – Persephone`}
  description={post.data.seoDescription ?? post.data.description}
>
  <article class="post">
    <header class="post-header container">
      {post.data.category && post.data.category.length > 0 && (
        <span class="eyebrow">{post.data.category.join(', ')}</span>
      )}
      <h1 class="heading-black">{post.data.title}</h1>
      <time class="post-date" datetime={post.data.publishDate.toISOString().slice(0, 10)}>
        {dateLabel}
      </time>
      {post.data.updatedDate && (
        <time class="post-date post-date-updated" datetime={post.data.updatedDate.toISOString().slice(0, 10)}>
          Aktualisiert am {updatedLabel}
        </time>
      )}
    </header>
    {
      post.data.heroImage && (
        <div class="post-hero">
          <Image src={post.data.heroImage} alt={post.data.heroImageAlt ?? ''} width={1200} height={675} />
        </div>
      )
    }
    <div class="post-body container">
      <Content />
    </div>

    {
      /* NACHTLAUF-2026-09-08.md B9: live's author/newsletter block, fetched
         from the live page's own markup (persephone.at, an article page) --
         not the homepage/newsletter-band copy, its own shorter line. */
    }
    <div class="post-author container">
      <a href="/ueber-uns/" class="eyebrow">Marina von Persephone</a>
      <p>Für weitere Einblicke in die Kinderwunschreise</p>
      <a href="/newsletter/" class="button button-primary">e-Brief abonnieren</a>
    </div>

    {
      related.length > 0 && (
        <div class="post-related container">
          <h2 class="section-heading">Verwandte Beiträge</h2>
          {/* NACHTLAUF-2026-09-09.md E7: reuses the homepage's own
             BlogTeaserCard (image + eyebrow + title + "Weiterlesen") so
             related posts look the same as the front-page blog grid,
             instead of the text-only .post-related-item cards this used
             to be (no image at all). */}
          <div class="post-related-grid">
            {related.map((r) => (
              <BlogTeaserCard
                href={`/blog/${r.id.split('/').slice(1).join('/')}/`}
                title={r.data.title}
                category={r.data.category}
                heroImage={r.data.heroImage}
                heroImageAlt={r.data.heroImageAlt}
                readMoreLabel="Weiterlesen"
              />
            ))}
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-header {
    max-width: 42rem;
    padding-block: clamp(3rem, 6vw, 4rem) 2rem;
  }

  .post-header h1 {
    color: var(--color-accent-strong);
  }

  .post-date {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .post-date-updated {
    margin-top: 0.25rem;
    font-size: 0.8rem;
  }

  .post-hero img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .post-body {
    max-width: 42rem;
    padding-block: 3rem;
    line-height: 1.75;
  }

  /* NACHTLAUF-2026-09-08.md B9: live's in-article subheadings render in
     caps. The article body comes from the markdown renderer, not this
     component's own template, so it never carries this file's scoping
     attribute -- :global() is required for the rule to reach it at all. */
  /* NACHTLAUF-2026-09-09.md E6: live measures these teal (--color-accent,
     #309898) — the same color as .eyebrow — not the inherited dark
     --color-text this only had uppercase for. */
  :global(.post-body h2) {
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .post-author {
    max-width: 42rem;
    padding-block: 2.5rem;
    border-top: 1px solid rgba(24, 26, 43, 0.12);
    text-align: center;
  }

  .post-author .eyebrow {
    display: inline-block;
    text-decoration: none;
  }

  .post-author p {
    margin: 0.5rem 0 1.25rem;
  }

  .post-related {
    padding-block: 1rem 4rem;
  }

  /* NACHTLAUF-2026-09-09.md E7: three BlogTeaserCards instead of the old
     text-only .post-related-item cards (their card/category/link styling
     lived here and is gone now that BlogTeaserCard supplies its own). */
  .post-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .post-related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
