---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogTeaserCard from '../../components/BlogTeaserCard.astro';
import { parseMarkdownBlocks } from '../../lib/parseMarkdownBlocks';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .filter((p) => p.id.startsWith('de/'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Hero eyebrow/title/intro previously invented ("Texte über den Weg durch die
// Krise" has no source) -- now pulled from the live page's own real text
// (its heading is wrapped oddly in the source, a <p> nested inside the <h1>,
// an Avada quirk -- confirmed by directly reading the raw HTML, not just its
// meta tags).
const entry = await getEntry('pages', 'de/blog');
if (!entry) throw new Error('Content collection entry "pages/de/blog" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const heroEyebrow = (blocks[0].type === 'paragraph' && blocks[0].text) || undefined;
const heroTitle = blocks[1].type === 'heading' ? blocks[1].text : entry.data.title;
const heroIntro = (blocks[2].type === 'paragraph' && blocks[2].text) || undefined;
---
<BaseLayout
  locale="de"
  path="/blog/"
  title={`${entry.data.title} – Persephone`}
>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {
          posts.map((post) => (
            <BlogTeaserCard
              href={`/blog/${post.id.split('/').slice(1).join('/')}/`}
              title={post.data.title}
              category={post.data.category}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
              readMoreLabel="Weiterlesen"
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
