---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogTeaserCard from '../../components/BlogTeaserCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .filter((p) => p.id.startsWith('de/'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout
  locale="de"
  path="/blog/"
  title="Blog – Persephone"
  description="Texte über reproduktive Krisen, Beziehung, Trauer und Kraft — der Persephone-Blog."
>
  <PageHero eyebrow="Blog" title="Texte über den Weg durch die Krise" />

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {
          posts.map((post) => (
            <BlogTeaserCard
              href={`/blog/${post.id.split('/').slice(1).join('/')}/`}
              title={post.data.title}
              category={post.data.category}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
              readMoreLabel="Weiterlesen"
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
