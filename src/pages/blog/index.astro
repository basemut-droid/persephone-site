---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogTeaserCard from '../../components/BlogTeaserCard.astro';
import blogHeroImage from '../../assets/pages/blog/marina-schreibtisch.png';
import { parseMarkdownBlocks, BlockTracker } from '../../lib/parseMarkdownBlocks';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .filter((p) => p.id.startsWith('de/'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Hero eyebrow/title/intro previously invented ("Texte über den Weg durch die
// Krise" has no source) -- now pulled from the live page's own real text
// (its heading is wrapped oddly in the source, a <p> nested inside the <h1>,
// an Avada quirk -- confirmed by directly reading the raw HTML, not just its
// meta tags).
const entry = await getEntry('pages', 'de/blog');
if (!entry) throw new Error('Content collection entry "pages/de/blog" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);
const { eyebrow: heroEyebrow, title: heroTitle, intro: heroIntro } = tracker.heroFields(entry.data.title);
tracker.assertAllHandled('blog/index.astro');
---
<BaseLayout
  locale="de"
  path="/blog/"
  title={`${entry.data.title} – Persephone`}
>
  {
    /* Confirmed against the live page's raw HTML (RUN-2026-09-07.md Phase E /
       FIXES-2026-09-07.md task 2): a different photo from the other subpages
       — Marina at her desk under a copper lamp — downloaded from the live
       Blog page's own --awb-bg-image (MG_7767-scaled.png), not the shared
       pomegranate. Owner-confirmed rights (task 2, "Photo rights"): her
       husband photographed every portrait of her on this site. */
  }
  <PageHero
    eyebrow={heroEyebrow}
    title={heroTitle}
    intro={heroIntro}
    image={blogHeroImage}
    imageAlt="Marina von Persephone arbeitet am Laptop an ihrem Schreibtisch"
  />

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {
          posts.map((post) => (
            <BlogTeaserCard
              href={`/blog/${post.id.split('/').slice(1).join('/')}/`}
              title={post.data.title}
              category={post.data.category}
              heroImage={post.data.heroImage}
              heroImageAlt={post.data.heroImageAlt}
              readMoreLabel="Weiterlesen"
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
