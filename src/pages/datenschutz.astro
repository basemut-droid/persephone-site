---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="de" path="/datenschutz/" title="Datenschutzerklärung – Persephone">
  <section class="container legal-page">
    <h1>Datenschutzerklärung</h1>
    <p>
      <em>Platzhalter — der vollständige Text (Verantwortlicher, Zwecke der Verarbeitung,
      eingesetzte Tools wie Consent-Management, Newsletter-Anbieter, Hosting, Rechte
      Betroffener) wird noch nachgereicht, sobald Consent-Tool und Newsletter-Anbieter
      feststehen.</em>
    </p>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding-block: 4rem;
    max-width: 70ch;
  }
</style>
