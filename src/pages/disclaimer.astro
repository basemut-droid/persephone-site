---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { parseMarkdownBlocks, paragraphs, mdInlineHtml, rewriteLocalLinks } from '../lib/parseMarkdownBlocks';

const entry = await getEntry('pages', 'de/disclaimer');
if (!entry) throw new Error('Content collection entry "pages/de/disclaimer" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const heroTitle = blocks[0].type === 'heading' ? blocks[0].text : entry.data.title;
// Source links are absolute persephone.at URLs (both real, working pages) —
// rewritten to local routes per docs/content-audit.md's carry-forward note.
const body = paragraphs(blocks).map((p) => rewriteLocalLinks(p));
---

<BaseLayout locale="de" path="/disclaimer/" title={`${entry.data.title} – Persephone`}>
  <PageHero title={heroTitle} />

  <section class="section">
    <div class="container section-narrow">
      {body.map((p) => <p set:html={mdInlineHtml(p)} />)}
    </div>
  </section>
</BaseLayout>
