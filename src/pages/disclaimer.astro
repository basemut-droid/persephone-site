---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { parseMarkdownBlocks, paragraphs, mdInlineHtml, rewriteLocalLinks, BlockTracker } from '../lib/parseMarkdownBlocks';

const entry = await getEntry('pages', 'de/disclaimer');
if (!entry) throw new Error('Content collection entry "pages/de/disclaimer" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);
const titleBlock = tracker.at(0);
const heroTitle = titleBlock.type === 'heading' ? titleBlock.text : entry.data.title;
// Source links are absolute persephone.at URLs (both real, working pages) —
// rewritten to local routes per docs/content-audit.md's carry-forward note.
const body = paragraphs(tracker.slice(1)).map((p) => rewriteLocalLinks(p));
// This page has legal weight (external-review.md 3c: training-status
// disclosure) — assertAllHandled() here is the guarantee that a future
// edit adding a paragraph can't silently fail to render it.
tracker.assertAllHandled('disclaimer.astro');
---

<BaseLayout locale="de" path="/disclaimer/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  {/* Confirmed no hero image on the live page (RUN-2026-09-07.md Phase E):
     its raw HTML has no --awb-bg-image anywhere. */}
  <PageHero title={heroTitle} image={false} />

  <section class="section">
    <div class="container section-narrow disclaimer-body">
      {body.map((p) => <p set:html={mdInlineHtml(p)} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* LAUF-2026-09-10.md B3 point 1: "Titel soll auf einer Seite" — Claudio's
     reading is "auf einer Zeile" (one line), given the surrounding
     complaint about the page feeling cramped. Scoped to this page's own
     heading rather than PageHero's shared .page-hero h1 (used by
     Datenschutz/FAQs/Impressum too, none of them flagged) — nowrap alone
     would overflow a long title on a narrow phone, so the font shrinks
     enough first to still fit. */
  :global(.page-hero h1) {
    white-space: nowrap;
    font-size: clamp(1.35rem, 4.2vw, 3rem);
  }

  /* B3 point 3: hyperlinks in the flowing body text get a mint-green
     highlight behind them ("unterlegen", literally — the link text itself
     stays --color-text, not recolored) rather than the site's usual plain
     underline. :global() is required — the links are inside set:html
     content from mdInlineHtml(), so they never carry this file's own
     scoping attribute. */
  .disclaimer-body :global(a) {
    background: var(--color-sage);
    padding: 0.05em 0.3em;
    border-radius: 3px;
    text-decoration: underline;
  }
</style>
