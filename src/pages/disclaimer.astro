---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseMarkdownBlocks, paragraphs, mdInlineHtml, rewriteLocalLinks, BlockTracker } from '../lib/parseMarkdownBlocks';

const entry = await getEntry('pages', 'de/disclaimer');
if (!entry) throw new Error('Content collection entry "pages/de/disclaimer" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);
const titleBlock = tracker.at(0);
const heroTitle = titleBlock.type === 'heading' ? titleBlock.text : entry.data.title;
// Source links are absolute persephone.at URLs (both real, working pages) —
// rewritten to local routes per docs/content-audit.md's carry-forward note.
const body = paragraphs(tracker.slice(1)).map((p) => rewriteLocalLinks(p));
// This page has legal weight (external-review.md 3c: training-status
// disclosure) — assertAllHandled() here is the guarantee that a future
// edit adding a paragraph can't silently fail to render it.
tracker.assertAllHandled('disclaimer.astro');
---

<BaseLayout locale="de" path="/disclaimer/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  <section class="section">
    <div class="container section-narrow disclaimer-body">
      {/* Live correction, 2026-09-12: matched to Datenschutz's own title
         treatment (itself a 2026-09-11 live correction against the live
         page) for consistency across the legal/utility pages — no
         separate PageHero banner, just a small eyebrow-style label
         directly in the body's own light section. Still this page's one
         real <h1>, just styled like the site's other small section
         labels instead of a hero title. Replaces both of this page's
         earlier PageHero-specific fixes (the forced-one-line nowrap and
         the widened .page-hero-inner) — neither applies to a plain h1. */}
      <h1 class="eyebrow">{heroTitle}</h1>
      {body.map((p) => <p set:html={mdInlineHtml(p)} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* B3 point 3, corrected live via screenshot after the first pass: the
     LAUF doc's own reading of "unterlegen" (a mint background behind
     dark text — measured as the only variant clearing 4.5:1 contrast)
     turned out not to be what was wanted. Claudio's screenshot during
     this session shows plain green text instead, no background box — the
     text color itself carries the emphasis. --color-accent (#309898),
     the site's standard teal link/eyebrow tone; underline stays so the
     link is still distinguishable by more than color alone. Contrast is
     3.27:1 on this page's background — under 4.5:1 for body text — a
     known trade-off of this explicit direction, not an oversight; noted
     in the handoff. :global() is required — the links are inside
     set:html content from mdInlineHtml(), so they never carry this
     file's own scoping attribute. */
  .disclaimer-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
