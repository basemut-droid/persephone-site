---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="de" path="/impressum/" title="Impressum – Persephone">
  <section class="container legal-page">
    <h1>Impressum</h1>
    <p>
      <em>Platzhalter — der rechtlich verbindliche Text (Diensteanbieter, Kontaktdaten, ggf.
      Kammer/Gewerbeaufsicht, UID-Nummer) wird noch nachgereicht und hier eingesetzt.</em>
    </p>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding-block: 4rem;
    max-width: 70ch;
  }
</style>
