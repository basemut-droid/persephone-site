---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { parseMarkdownBlocks, paragraphs, mdInlineHtml, BlockTracker } from '../lib/parseMarkdownBlocks';

const entry = await getEntry('pages', 'de/impressum');
if (!entry) throw new Error('Content collection entry "pages/de/impressum" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);
const titleBlock = tracker.at(0);
const heroTitle = titleBlock.type === 'heading' ? titleBlock.text : entry.data.title;
// The live source's tel: link literally contains spaces (tel:+43 665
// 67221738) — a non-functional URI. Using the corrected, working format
// here is a plumbing fix (no text changed), same call made in an earlier
// session for this exact page (see OPEN-QUESTIONS.md #5's neighboring
// context on this page).
const body = paragraphs(tracker.slice(1)).map((p) => mdInlineHtml(p).replace('tel:+43 665 67221738', 'tel:+436656721738'));
tracker.assertAllHandled('impressum.astro');
// entry.data.description is the live site's own mangled, space-less
// auto-excerpt (OPEN-QUESTIONS.md #5) — not shipped. Owner decision
// 2026-09-06 (fuer-marina.md Q6): a clean, minimal description instead.
const metaDescription = 'Impressum und Offenlegung von Persephone – Marina Bletsas, Wien.';
---

<BaseLayout locale="de" path="/impressum/" title={`${entry.data.title} – Persephone`} description={metaDescription}>
  {/* Confirmed no hero image on the live page (RUN-2026-09-07.md Phase E):
     its raw HTML has no --awb-bg-image anywhere. Live correction,
     2026-09-12: reverted a same-week detour to a plain eyebrow-style
     <h1> — Claudio wants this page to look like FAQs' own big-red-title
     PageHero banner, just genuinely left-aligned (fixed centrally in
     PageHero.astro). */}
  <PageHero title={heroTitle} image={false} />

  <section class="section">
    <div class="container section-narrow">
      {body.map((p) => <p set:html={p} />)}
    </div>
  </section>
</BaseLayout>
