---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

// The live page has no narrative copy in its source at all -- the entire
// page is one embedded Microsoft Bookings calendar (see
// src/content/pages/de/kennenlernen.md).
// C2 (fuer-marina.md Frage 17, OPEN-QUESTIONS.md #8/#24, decided
// 2026-09-08): renamed from "Termine" -- both the name and the URL.
const entry = await getEntry('pages', 'de/kennenlernen');
if (!entry) throw new Error('Content collection entry "pages/de/kennenlernen" not found');

const bookingUrl = 'https://outlook.office.com/book/ErstgesprchfrDichallein@persephone.at/?ismsaljsauthenabled';

// NIGHT-RUN.md Phase 4.3 / external-review.md finding #1b: the page had
// no explanatory copy at all -- just the word "Termine" and an embed.
// Rather than invent a new marketing sentence, this reuses the real,
// already-verified sentence that describes this exact same 20-minute,
// free, no-obligation "Kennenlernen" call elsewhere on the site
// (beratung.md's own line about the call itself). FIXES-2026-09-07.md task
// 5e: both intro sentences used to state the 20-minute length; kept one.
const intro = 'Das online Kennenlernen (ca. 20 Min.) ist kostenfrei und dient dem gegenseitigen Beschnuppern und der Klärung Deines Anliegens.';
---

<BaseLayout locale="de" path="/kennenlernen/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  {/* NACHTLAUF-2026-09-09.md E9: Claudio's own deliberate design call, not
     a live-site correction -- the earlier image={false} choice just below
     was itself a confirmed, correct read of the live page at the time
     (RUN-2026-09-07.md Phase E: no --awb-bg-image in its raw HTML). This
     supersedes it: split-hero with the default pomegranate image, like
     every other subpage, plus the intro sentence moved up into the hero
     (out of .booking-wrap below) instead of sitting under the calendar. */}
  <PageHero title="Kennenlernen vereinbaren" intro={intro} />

  <section class="section">
    <div class="container">
      {/* FIXES-2026-09-07.md task 5e — decision by the owner's husband,
         2026-09-07: go back to the calendar embedded directly, without the
         click-to-load step this session had built as the consent-safer
         alternative. That earlier version's own comment explained the
         trade-off it was avoiding; recorded now in OPEN-QUESTIONS.md
         instead, as a decision for the owner rather than settled by
         code — an unconditional iframe here contacts Microsoft on every
         page view, before any consent, which is the one thing on this
         otherwise tracker-free site that makes a cookie banner necessary.
         Implementing what was asked; not adding a banner on this run's own
         initiative either way. */}
      <iframe
        src={bookingUrl}
        width="100%"
        height="750"
        style="border:0"
        title="Terminbuchung"
        class="booking-iframe"
      />
      <p class="booking-fallback">
        Lädt der Kalender nicht? <a href={bookingUrl}>Direkt bei Microsoft buchen</a>.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container section-narrow section-centered">
      <p>
        Allgemeine Fragen, ein Anliegen zu einem Workshop oder etwas anderes?
        Nutze dafür das <a href="/kontakt/">Kontaktformular</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* NACHTLAUF-2026-09-09.md E10: measured iframe (816px) vs .booking-wrap
     (896px) vs .container (1248px) confirmed cause (b) -- this 56rem
     reading-width cap was narrower than "das Element, in dem er
     eingebaut ist" (Claudio's phrasing), not a Microsoft Bookings
     self-centering limit. Section now uses the regular .container width
     like every other section on the site. */

  .booking-iframe {
    border-radius: var(--radius);
    display: block;
  }

  .booking-fallback {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
