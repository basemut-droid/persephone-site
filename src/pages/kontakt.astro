---
// LAUF-2026-09-10.md Teil C — Kontaktseite neu, Version A ("Router") aus
// docs/mockups/kontakt-prototype.dc.html, Marina's eigener Entwurf in
// Claude Design. Aufbau, Maße, Texte und Verhalten kommen von dort (siehe
// C1); Schrift/Tokens/keine externen Ladevorgänge kommen vom Projekt
// (C2) — der Prototyp lädt Google Fonts und schreibt Hexwerte direkt,
// beides bleibt hier draußen. Die alte, block-getrackte Extraktion aus
// src/content/pages/de/kontakt.md passt nicht mehr: die Seite hat eine
// komplett andere Form (zwei Karten, ein Klapp-Formular) als das alte alte
// Fließtext-Layout, das dieser Content-Eintrag ursprünglich beschrieb.
// title/description bleiben aus dem Content-Eintrag (echte, gepflegte
// Meta-Werte); die sichtbare Seiten-Kopie unten ist Marinas eigener
// Text aus dem Prototyp, direkt übernommen statt neu erfunden.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import marinaHero from '../assets/pages/kontakt/mg-7811.png';
import marinaAvatar from '../assets/shared/marina-von-persephone.jpg';

const entry = await getEntry('pages', 'de/kontakt');
if (!entry) throw new Error('Content collection entry "pages/de/kontakt" not found');
---

<BaseLayout locale="de" path="/kontakt/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  <section class="hero kontakt-hero">
    <div class="hero-grid kontakt-hero-grid">
      <div class="hero-copy kontakt-hero-copy reveal reveal-left">
        <span class="eyebrow">Einladung</span>
        {/* Prototyp-Korrektur schon eingearbeitet (C1): rot, nicht fett,
           und der Satz endet auf "...vereinbare direkt ein Gespräch." —
           nicht die ältere Fassung mit "Möchtest Du Marina persönlich
           kennenlernen". */}
        <h1 class="kontakt-title">Lass uns ins Gespräch kommen</h1>
        <p>
          Schreib mir, wenn Du eine Frage hast oder mit mir zusammenarbeiten möchtest. Bist Du bereit für ein
          Kennenlernen, vereinbare direkt ein Gespräch.
        </p>
      </div>
      <div class="hero-image reveal reveal-right">
        <Image src={marinaHero} alt="Porträtfoto von Marina Bletsas, Gründerin von Persephone" width={900} height={750} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container kontakt-container">
      <div class="kontakt-cards">
        {
          /* "Schreib mir": ein natives <details>, kein Script — ein Klick
             irgendwo auf die Karte (der ganze <summary>) klappt das
             Formular auf, komplett tastaturbedienbar und ohne JavaScript
             erreichbar, aus dem Stand. Der Pfeil-Text tauscht per reinem
             CSS (details[open] unten), ohne eigenen Zustand.

             Korrektur nach erstem Feedback: das Klapp-Panel lag vorher
             ALS KIND dieses <details> — dadurch wuchs nur diese eine Karte
             beim Öffnen in die Höhe, während "Kennenlernen" daneben ihre
             ursprüngliche Größe behielt. Das Panel ist jetzt ein
             GESCHWISTER-Element von .kontakt-cards (siehe unten, nach
             diesem Grid), sichtbar gemacht über
             :has(.kontakt-card-write[open]) — dieselbe reine-CSS-Technik
             wie Angebotes Wiedererkennungs-Auswahl (B8), wieder ganz ohne
             JavaScript. So bleiben beide Karten in der Reihe gleich groß,
             und das Formular klappt unterhalb der ganzen Reihe auf, wie
             im Prototyp. */
        }
        <details class="kontakt-card kontakt-card-write">
          <summary>
            <span class="icon-circle kontakt-icon-teal">
              <Icon name="mail" size={20} />
            </span>
            <span class="eyebrow kontakt-card-eyebrow">Frage oder Zusammenarbeit</span>
            <h2>Schreib mir</h2>
            <p>
              Für Fragen zu Persephone, Kooperationsideen oder Presseanfragen. Ich antworte i.d.R. innerhalb von 48
              Std.
            </p>
            <span class="kontakt-card-cta">
              <span class="label-closed">Nachricht schreiben →</span>
              <span class="label-open">Formular ausblenden ←</span>
            </span>
          </summary>
        </details>

        {
          /* "Termin buchen": LAUF-2026-09-10.md C3 point 3 — verlinkt
             vorerst auf /kennenlernen/, nicht auf ein Overlay (offene
             Frage, siehe Abschlussbericht). */
        }
        <a href="/kennenlernen/" class="kontakt-card kontakt-card-book">
          <span class="icon-circle kontakt-icon-terracotta-solid">
            <Icon name="calendar" size={20} />
          </span>
          <span class="eyebrow kontakt-card-eyebrow-red">Kennenlernen</span>
          <h2>Vereinbare ein Kennenlerngespräch</h2>
          <p>Kostenlos und unverbindlich, online über Teams. Du wählst Deinen Termin direkt im Kalender.</p>
          <span class="kontakt-card-cta kontakt-card-cta-red">Termin buchen →</span>
        </a>
      </div>

      <div class="kontakt-message-panel">
        <div class="kontakt-person-col">
          <div class="kontakt-person">
            <Image src={marinaAvatar} alt="" aria-hidden="true" width={104} height={104} class="kontakt-avatar" />
            <div>
              <p class="kontakt-person-name">Dr.Phil. Marina Bletsas</p>
              <p class="kontakt-person-alias">aka Marina von Persephone</p>
            </div>
          </div>

          <div class="kontakt-detail-row">
            <span class="icon-circle icon-circle-sm kontakt-icon-terracotta">
              <Icon name="pin" size={15} />
            </span>
            <div>
              <span class="eyebrow kontakt-detail-eyebrow">Standorte</span>
              <p class="kontakt-detail-strong">Wien</p>
              <p>Praxisraum im 3. Bezirk (Rochusmarkt) · Walk &amp; Talk im 2. Bezirk (Prater)</p>
              <p class="kontakt-detail-strong">Online</p>
              <p>Über Teams</p>
            </div>
          </div>

          <div class="kontakt-detail-row">
            <span class="icon-circle icon-circle-sm kontakt-icon-terracotta">
              <Icon name="clock" size={15} />
            </span>
            <div>
              <span class="eyebrow kontakt-detail-eyebrow">Terminverfügbarkeit</span>
              <p>Mi–Fr, 10–14 Uhr; in besonderen Fällen Abend- und Wochenendtermine gegen Aufpreis möglich.</p>
            </div>
          </div>
        </div>

        <div class="kontakt-form-col">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* .hero/.hero-grid/.hero-copy/.hero-image are shared (global.css); only
     this page's own deviations from their defaults are overridden below —
     the prototype's hero uses an equal 1fr/1fr split (not the shared
     45%/55%) and a differently-colored, non-bold title. */
  .kontakt-hero {
    background: var(--color-bg-alt);
  }

  @media (min-width: 900px) {
    .kontakt-hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Prototype: font 400 36px, color #D83830 (--color-terracotta-dark) —
     deliberately not this site's usual hero title treatment
     (--color-accent-strong/.heading-black), per Marina's own correction
     already baked into the prototype (C1). */
  .kontakt-title {
    color: var(--color-terracotta-dark);
    font-weight: 400;
  }

  .kontakt-container {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .kontakt-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    /* Zweites Feedback: "beide Boxen sollen gleich groß sein" — war
       align-items:start, wodurch jede Karte nur ihre eigene Inhaltshöhe
       hatte. stretch (der Grid-Default, hier explizit) plus .kontakt-card
       selbst auf height:100% lässt beide Karten die Höhe der jeweils
       größeren annehmen, unabhängig vom Öffnen-Zustand. */
    align-items: stretch;
  }

  .kontakt-card {
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-radius: 0.75rem;
    cursor: pointer;
  }

  /* .kontakt-card-book (an <a>) holds its visible content directly, so
     the flex column + bottom-pinned CTA lives on the card itself.
     .kontakt-card-write (a <details>) holds it inside its <summary>
     instead — see the rule further down — so this only covers the "a"
     card's own padding/layout, not both. */
  .kontakt-card-book {
    display: flex;
    flex-direction: column;
    padding: 2rem;
  }

  .kontakt-card h2 {
    margin: 0.5rem 0 0;
    font-size: 1.375rem;
  }

  .kontakt-card p {
    margin: 0.75rem 0 0;
  }

  .kontakt-card-eyebrow,
  .kontakt-card-eyebrow-red {
    display: block;
    margin: 1rem 0 0;
  }

  .kontakt-card-eyebrow-red {
    color: var(--color-terracotta-dark);
  }

  .kontakt-card-cta {
    display: block;
    /* auto statt fest 1rem: schiebt die CTA-Zeile in der kürzeren Karte
       nach unten, sodass beide Karten trotz unterschiedlich langer Texte
       bündig mit der CTA abschließen. */
    margin-top: auto;
    padding-top: 1rem;
    font-weight: 700;
  }

  .kontakt-card-cta-red {
    color: var(--color-accent-strong);
  }

  .kontakt-icon-teal,
  .kontakt-icon-terracotta-solid {
    color: var(--color-bg);
  }

  .kontakt-icon-teal {
    background: var(--color-teal);
  }

  .kontakt-icon-terracotta-solid {
    background: var(--color-terracotta);
  }

  .kontakt-icon-terracotta {
    background: var(--color-terracotta);
    color: var(--color-bg);
  }

  /* "Schreib mir" — neutral border, teal on hover/focus; the whole card
     is the <summary>'s native click target. */
  .kontakt-card-write {
    background: var(--color-surface);
    border: 1.5px solid rgba(24, 26, 43, 0.14);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .kontakt-card-write > summary {
    /* <details>'s only visible child when closed — the flex column +
       bottom-pinned CTA (.kontakt-card-cta's margin-top:auto) has to sit
       here, not on .kontakt-card-write itself, since that's the element
       actually holding the icon/eyebrow/h2/p/cta as direct children. */
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
    list-style: none;
  }

  .kontakt-card-write > summary::-webkit-details-marker {
    display: none;
  }

  .kontakt-card-write:hover,
  .kontakt-card-write:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(48, 152, 152, 0.12);
  }

  .label-open {
    display: none;
  }

  .kontakt-card-write[open] .label-closed {
    display: none;
  }

  .kontakt-card-write[open] .label-open {
    display: inline;
  }

  /* "Vereinbare ein Kennenlerngespräch" — red border, cream fill. */
  .kontakt-card-book {
    background: var(--color-bg);
    border: 1.5px solid var(--color-terracotta);
    transition: box-shadow 0.15s ease;
  }

  .kontakt-card-book:hover,
  .kontakt-card-book:focus-visible {
    box-shadow: 0 4px 16px rgba(179, 58, 59, 0.16);
  }

  /* Reines CSS, kein Script: .kontakt-message-panel ist jetzt ein
     Geschwister-Element von .kontakt-cards (siehe Markup-Kommentar oben),
     standardmäßig ausgeblendet und nur sichtbar, wenn die "Schreib
     mir"-Karte offen ist — :has() liest den [open]-Zustand des <details>
     irgendwo in .kontakt-cards, derselbe Ansatz wie Angebotes B8-Auswahl. */
  .kontakt-message-panel {
    display: none;
  }

  .kontakt-cards:has(.kontakt-card-write[open]) + .kontakt-message-panel {
    display: grid;
    margin-top: 2.5rem;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .kontakt-person-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .kontakt-person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kontakt-avatar {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }

  .kontakt-person-name {
    margin: 0;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .kontakt-person-alias {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .kontakt-detail-row {
    display: flex;
    gap: 0.75rem;
  }

  .kontakt-detail-row .icon-circle {
    flex: none;
  }

  .kontakt-detail-row p {
    margin: 0 0 0.25rem;
    font-size: 0.9rem;
  }

  .kontakt-detail-strong {
    font-weight: 700;
  }

  .kontakt-detail-eyebrow {
    margin-bottom: 0.35rem;
    font-size: 1rem;
  }

  @media (min-width: 700px) {
    .kontakt-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .kontakt-message-panel {
      grid-template-columns: 15rem 1fr;
    }
  }
</style>
