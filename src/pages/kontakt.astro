---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import mg7811 from '../assets/pages/kontakt/mg-7811.png';
import { parseMarkdownBlocks, mdInlineHtml } from '../lib/parseMarkdownBlocks';

// No split-hero image (masthead row has no --awb-bg-image) — plain PageHero.
const entry = await getEntry('pages', 'de/kontakt');
if (!entry) throw new Error('Content collection entry "pages/de/kontakt" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');

const heroEyebrow = (blocks[0].type === 'paragraph' && blocks[0].text) || undefined;
const heroTitle = blocks[1].type === 'heading' ? blocks[1].text : entry.data.title;
const heroIntro = (blocks[2].type === 'paragraph' && blocks[2].text) || undefined;

// blocks[3] is the portrait image; blocks[4] is a second, duplicate h1
// (desktop/mobile responsive pair, identical text minus a trailing period —
// same pattern as elsewhere on this site) — skipped, everything from
// blocks[5] on is the real body content.
const bodyBlocks = blocks.slice(5).filter((b) => b.type === 'paragraph');
---

<BaseLayout locale="de" path="/kontakt/" title={`${entry.data.title} – Persephone`}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <Image src={mg7811} alt="" width={240} height={360} />
        {bodyBlocks.map((p) => <p set:html={mdInlineHtml(p.type === 'paragraph' ? p.text : '')} />)}
      </div>
      <div class="contact-form-wrap">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .contact-info img {
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.6fr;
    }
  }
</style>
