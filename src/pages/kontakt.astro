---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import mg7811 from '../assets/pages/kontakt/mg-7811.png';
import { parseMarkdownBlocks, mdInlineHtml, BlockTracker } from '../lib/parseMarkdownBlocks';

// Corrected 2026-09-07 (RUN Phase E): the live masthead DOES have a split
// hero image (--awb-bg-image: persephone-granatapfel-fruchtbarkeit.jpg —
// the same file the homepage itself uses). An earlier comment here
// claiming otherwise was wrong; see docs/external-review.md's correction
// and FIXES-2026-09-07.md task 2. PageHero now defaults to that image.
const entry = await getEntry('pages', 'de/kontakt');
if (!entry) throw new Error('Content collection entry "pages/de/kontakt" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

const { eyebrow: heroEyebrow, title: heroTitle, intro: heroIntro } = tracker.heroFields(entry.data.title);

// blocks[3] is a second, duplicate h1 (desktop/mobile responsive pair,
// identical text minus a trailing period — same pattern as elsewhere on
// this site) — not re-rendered as its own heading, since PageHero already
// shows the first occurrence.
tracker.exclude(tracker.at(3), 'duplicate responsive h1, PageHero already renders the first occurrence');
// blocks[4] is the portrait image, rendered below via a statically
// imported asset rather than read from block data.
tracker.exclude(tracker.at(4), 'portrait image, rendered via static import below');

const introLine = tracker.at(5);
// "Erreichbarkeit" and "Standorte" previously had only their paragraphs
// extracted (a blanket .filter(b => b.type === 'paragraph') over
// everything from here on, which silently dropped both heading blocks) —
// exactly external-review.md finding #8. Both now render their own
// heading text via named sections.
const erreichbarkeit = tracker.section('Erreichbarkeit');
const standorte = tracker.section('Standorte');
tracker.assertAllHandled('kontakt.astro');
---

<BaseLayout locale="de" path="/kontakt/" title={`${entry.data.title} – Persephone`}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <Image src={mg7811} alt="Porträtfoto von Marina Bletsas, Gründerin von Persephone" width={240} height={360} />
        {introLine.type === 'paragraph' && <p set:html={mdInlineHtml(introLine.text)} />}
        <h2>Erreichbarkeit</h2>
        {erreichbarkeit.map((b) => b.type === 'paragraph' && <p set:html={mdInlineHtml(b.text)} />)}
        <h2>Standorte</h2>
        {standorte.map((b) => b.type === 'paragraph' && <p set:html={mdInlineHtml(b.text)} />)}
        {/* NIGHT-RUN.md Phase 4.3: a short pointer to the booking page,
           mirroring the one Termine gives back to this form. Kontakt and
           Termine stay two separate pages -- this is a cross-link, not a
           merge. */}
        <p class="booking-pointer">
          Direkt <a href="/termine/">Kennenlernen vereinbaren</a> — zwanzig Minuten, online, kostenfrei.
        </p>
      </div>
      <div class="contact-form-wrap">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .contact-info img {
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }

  .booking-pointer {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(24, 26, 43, 0.1);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.6fr;
    }
  }
</style>
