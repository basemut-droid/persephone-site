---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { parseMarkdownBlocks, section, paragraphs, BlockTracker } from '../lib/parseMarkdownBlocks';

// No split-hero image on the live page — plain PageHero, same as the other
// Angebote subpages.
const entry = await getEntry('pages', 'de/selbsthilfegruppe');
if (!entry) throw new Error('Content collection entry "pages/de/selbsthilfegruppe" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

const [b0, b1] = [tracker.at(0), tracker.at(1)];
const heroEyebrow = (b0.type === 'paragraph' && b0.text) || undefined;
const heroTitle = b1.type === 'heading' ? b1.text : entry.data.title;
// The live source had an unremoved English Avada demo heading here
// ("Your Journey to a Fulfilling Life") — dropped outright, per
// fuer-marina.md Q4. It also had two near-duplicate German intro
// paragraphs; the owner chose variant A (fuer-marina.md Q3, "weil sie...
// das Thema konkret benennt") and the second was removed from the
// content collection itself (OPEN-QUESTIONS.md #7), so only one remains
// here now.
tracker.exclude(tracker.at(2), 'unremoved Avada English demo heading — decided dropped, fuer-marina.md Q4');
const heroIntroBlock = tracker.at(3);
const heroIntro = heroIntroBlock.type === 'paragraph' ? heroIntroBlock.text : undefined;

const ueberDieGruppe = paragraphs(tracker.section('Über die Gruppe'));
const grundprinzipien = paragraphs(tracker.section('Grundprinzipien der Gruppe'));

// "Nächstes SHG-Treffen" is a second masthead-level (h1) heading mid-page,
// same live-site pattern as Über uns's "Dein nächster Schritt" — rendered
// as a regular h2 here, not a second .heading-black, per the design
// system's "one heading-black per page" rule (DESIGN-SYSTEM.md).
const treffenHeadingText = 'Nächstes SHG-Treffen';
const treffenIdx = blocks.findIndex((b) => b.type === 'heading' && b.text === treffenHeadingText);
if (treffenIdx === -1) throw new Error(`Expected heading "${treffenHeadingText}"`);
tracker.at(treffenIdx);
const treffenSection = tracker.slice(treffenIdx + 1);

// "Aktuelles" (h2) is a parent heading of the "Nächtes SHG-Treffen" (h3)
// subsection that follows it — section()'s hierarchical semantics
// correctly treat that h3 and everything under it as part of "Aktuelles"'
// own scope, which is right for a nested read but wrong for pulling out
// just its two immediate intro paragraphs (it would include the h3
// subsection's own closing paragraph too). Bounded manually here instead,
// stopping at the very next heading of any level.
const aktuellesIdx = treffenSection.findIndex((b) => b.type === 'heading' && b.text === 'Aktuelles');
const nextHeadingOffset = treffenSection.slice(aktuellesIdx + 1).findIndex((b) => b.type === 'heading');
const aktuellesBlocks =
  nextHeadingOffset === -1 ? treffenSection.slice(aktuellesIdx + 1) : treffenSection.slice(aktuellesIdx + 1, aktuellesIdx + 1 + nextHeadingOffset);
const aktuelles = paragraphs(aktuellesBlocks);
const details = section(treffenSection, 'Nächstes SHG-Treffen');
const detailsList = details.find((b) => b.type === 'list');
const cta = details.find((b) => b.type === 'cta');
if (!cta || cta.type !== 'cta') throw new Error('Expected the sign-up CTA');
const closingNote = treffenSection.find((b, i) => b.type === 'paragraph' && i > treffenSection.indexOf(cta));
// treffenSection (and everything in it — aktuelles/details/cta/closingNote
// above) was already marked handled in one shot by the tracker.slice()
// call that produced it.
tracker.assertAllHandled('selbsthilfegruppe.astro');
---

<BaseLayout locale="de" path="/selbsthilfegruppe/" title={`${entry.data.title} – Persephone`}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  <section class="section">
    <div class="container section-narrow">
      <h2>Über die Gruppe</h2>
      {ueberDieGruppe.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container section-narrow">
      <h2>Grundprinzipien der Gruppe</h2>
      <ul class="principles">
        {grundprinzipien.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container section-narrow next-meeting">
      <span class="eyebrow">Aktuelles</span>
      <h2>{treffenHeadingText}</h2>
      {aktuelles.map((p) => <p>{p}</p>)}
      {
        detailsList?.type === 'list' && (
          <p class="meeting-details">
            {detailsList.items.map((item) => (
              <>
                {item}
                <br />
              </>
            ))}
          </p>
        )
      }
      <a href={cta.href} class="button button-primary">{cta.text}</a>
      {closingNote?.type === 'paragraph' && <p class="closing-note">{closingNote.text}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .principles {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  .principles li {
    border-left: 3px solid var(--color-accent-strong);
    padding-left: 1rem;
  }

  .next-meeting {
    background: var(--color-bg-alt);
    padding: 2rem;
    border-radius: var(--radius);
  }

  .meeting-details {
    font-weight: 700;
    color: var(--color-text);
  }

  .closing-note {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
