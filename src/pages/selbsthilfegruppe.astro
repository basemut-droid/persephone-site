---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import steiermarkLogo from '../assets/pages/selbsthilfegruppe/selbsthilfe-steiermark-logo.png';
import { parseMarkdownBlocks, section, paragraphs, BlockTracker } from '../lib/parseMarkdownBlocks';

// Corrected 2026-09-07 (RUN Phase E): the live masthead DOES have a split
// hero image (the same pomegranate illustration as the homepage). An
// earlier comment here claiming otherwise was wrong; see
// docs/external-review.md's correction and FIXES-2026-09-07.md task 2.
// PageHero now defaults to that image.
const entry = await getEntry('pages', 'de/selbsthilfegruppe');
if (!entry) throw new Error('Content collection entry "pages/de/selbsthilfegruppe" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

const [b0, b1] = [tracker.at(0), tracker.at(1)];
const heroEyebrow = (b0.type === 'paragraph' && b0.text) || undefined;
const heroTitle = b1.type === 'heading' ? b1.text : entry.data.title;
// The live source had an unremoved English Avada demo heading here
// ("Your Journey to a Fulfilling Life") — dropped outright, per
// fuer-marina.md Q4. It also had two near-duplicate German intro
// paragraphs; the owner chose variant A (fuer-marina.md Q3, "weil sie...
// das Thema konkret benennt") and the second was removed from the
// content collection itself (OPEN-QUESTIONS.md #7), so only one remains
// here now.
tracker.exclude(tracker.at(2), 'unremoved Avada English demo heading — decided dropped, fuer-marina.md Q4');
const heroIntroBlock = tracker.at(3);
const heroIntro = heroIntroBlock.type === 'paragraph' ? heroIntroBlock.text : undefined;

const ueberDieGruppe = paragraphs(tracker.section('Über die Gruppe'));
const grundprinzipien = paragraphs(tracker.section('Grundprinzipien der Gruppe'));
const principles = (entry.data.principles ?? []).map((p, i) => ({
  icon: p.icon as IconName,
  label: p.label,
  text: grundprinzipien[i] ?? '',
}));

// "Nächstes SHG-Treffen" is a second masthead-level (h1) heading mid-page,
// same live-site pattern as Über uns's "Dein nächster Schritt" — rendered
// as a regular h2 here, not a second .heading-black, per the design
// system's "one heading-black per page" rule (DESIGN-SYSTEM.md).
const treffenHeadingText = 'Nächstes SHG-Treffen';
const treffenIdx = blocks.findIndex((b) => b.type === 'heading' && b.text === treffenHeadingText);
if (treffenIdx === -1) throw new Error(`Expected heading "${treffenHeadingText}"`);
tracker.at(treffenIdx);
const treffenSection = tracker.slice(treffenIdx + 1);

// "Aktuelles" (h2) is a parent heading of the "Nächstes SHG-Treffen" (h3)
// subsection that follows it — section()'s hierarchical semantics
// correctly treat that h3 and everything under it as part of "Aktuelles"'
// own scope, which is right for a nested read but wrong for pulling out
// just its two immediate intro paragraphs (it would include the h3
// subsection's own closing paragraph too). Bounded manually here instead,
// stopping at the very next heading of any level.
const aktuellesIdx = treffenSection.findIndex((b) => b.type === 'heading' && b.text === 'Aktuelles');
const nextHeadingOffset = treffenSection.slice(aktuellesIdx + 1).findIndex((b) => b.type === 'heading');
const aktuellesBlocks =
  nextHeadingOffset === -1 ? treffenSection.slice(aktuellesIdx + 1) : treffenSection.slice(aktuellesIdx + 1, aktuellesIdx + 1 + nextHeadingOffset);
const aktuelles = paragraphs(aktuellesBlocks);
const details = section(treffenSection, 'Nächstes SHG-Treffen');
const detailsList = details.find((b) => b.type === 'list');
const cta = details.find((b) => b.type === 'cta');
if (!cta || cta.type !== 'cta') throw new Error('Expected the sign-up CTA');
const closingNote = treffenSection.find((b, i) => b.type === 'paragraph' && i > treffenSection.indexOf(cta));
if (!closingNote || closingNote.type !== 'paragraph') throw new Error('Expected the closing Selbsthilfe Steiermark note');
// treffenSection (and everything in it — aktuelles/details/cta/closingNote
// above) was already marked handled in one shot by the tracker.slice()
// call that produced it.
tracker.assertAllHandled('selbsthilfegruppe.astro');

// The meeting details (date/time/address) are already three discrete list
// items in the source — a data problem this isn't; only the rendering (one
// bold paragraph joined by <br>) collapsed them. Icons are presentational,
// paired by position, not stored as content (FIXES-2026-09-07.md task 2e.3).
const detailIcons: IconName[] = ['calendar', 'clock', 'pin'];
const detailItems = detailsList?.type === 'list' ? detailsList.items : [];
---

<BaseLayout locale="de" path="/selbsthilfegruppe/" title={`${entry.data.title} – Persephone`}>
  <PageHero eyebrow={heroEyebrow} title={heroTitle} intro={heroIntro} />

  {
    /* "Über die Gruppe", "Grundprinzipien der Gruppe" and "Aktuelles"/the
       meeting card are one continuous section on the live page (confirmed
       against its raw HTML: a single fusion-fullwidth row spans all three,
       one background color, not alternating bands) — previously split
       across .section/.section-alt/.section here, which invented a
       band-alternation the live design doesn't have (task 2e.5). */
  }
  <section class="section">
    <div class="container section-narrow section-centered">
      <h2 class="eyebrow">Über die Gruppe</h2>
      {ueberDieGruppe.map((p) => <p>{p}</p>)}
    </div>

    <div class="container section-narrow section-centered principles-heading">
      <h2 class="eyebrow">Grundprinzipien der Gruppe</h2>
    </div>
    <div class="container principles-grid">
      {
        principles.map((p) => (
          <div class="principle">
            <div class="icon-circle">
              <Icon name={p.icon} size={28} />
            </div>
            <p class="principle-label">{p.label}</p>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>

    <div class="container section-narrow next-meeting">
      {
        /* NACHTLAUF-2026-09-08.md B6: live has this heading a second time,
           big, above the "Aktuelles" eyebrow — not a duplicate to remove,
           the small <h3> inside the card below is also real on the live
           page. Same "second masthead-level heading mid-page" pattern as
           Über uns's "Dein nächster Schritt"; not .heading-black, per the
           design system's "one heading-black per page" rule. */
      }
      <h2 class="shg-treffen-heading">{treffenHeadingText}</h2>
      <span class="eyebrow">Aktuelles</span>
      {aktuelles.map((p) => <p>{p}</p>)}

      <div class="meeting-card">
        <h3>{treffenHeadingText}</h3>
        <ul class="icon-list icon-list-check meeting-details">
          {
            detailItems.map((item, i) => (
              <li>
                <Icon name={detailIcons[i]} size={16} />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <hr />
        <a href={cta.href} class="button button-primary meeting-cta">{cta.text}</a>
      </div>
    </div>
  </section>

  <section class="steiermark-band">
    <div class="container steiermark-grid">
      <div class="steiermark-logo">
        <Image src={steiermarkLogo} alt="Selbsthilfe Steiermark – Jugend am Werk" width={368} height={177} />
      </div>
      <p>{closingNote.text}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .principles-heading {
    margin-top: 3rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
    text-align: center;
  }

  .principle {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .principle .icon-circle {
    margin-bottom: 1rem;
  }

  .principle-label {
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .next-meeting {
    margin-top: 3rem;
  }

  /* NACHTLAUF-2026-09-08.md B6: live measures this at 40px — its own
     size, not the shared 28px h2/h3 scale (same pattern as the founder
     heading and Über uns's CTA heading: a one-off size for one specific
     heading, not a scale change). */
  .shg-treffen-heading {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .meeting-card {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 2rem;
    margin-top: 1.5rem;
    box-shadow: 0 4px 16px rgba(24, 26, 43, 0.06);
  }

  .meeting-card h3 {
    margin-bottom: 1.25rem;
  }

  .meeting-details {
    margin-bottom: 1.5rem;
  }

  .meeting-details li {
    font-weight: 700;
  }

  .meeting-card hr {
    border: none;
    border-top: 1px solid rgba(24, 26, 43, 0.1);
    margin: 0 0 1.5rem;
  }

  /* VERGLEICH-2026-09-07.md A3: live is massiv terracotta, 13px, uppercase,
     upright — smaller than every other primary button on the site (a
     one-off variant, not a sitewide token). The italic here was the same
     rebuild invention flagged for .button-hero; removed for the same
     reason (FIXES-2026-09-07.md task 2e.3's italic call is superseded by
     this). Colour is unchanged, per the DO NOT list. */
  .meeting-cta {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  @media (min-width: 700px) {
    .principles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Selbsthilfe Steiermark partner band (FIXES-2026-09-07.md task 2e.4) —
     confirmed against the live page's raw HTML: a full-width band at
     rgba(144,200,192,0.56), which is var(--color-sage) at 56% opacity, not
     a new color. Two columns: the white partner logo, and the partnership
     sentence in white. No portrait/tile CTA here — the owner confirmed
     this page correctly has none (see 2e's intro). */
  .steiermark-band {
    background: rgba(144, 200, 192, 0.56);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .steiermark-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .steiermark-logo {
    /* NACHTLAUF-2026-09-08.md B6: right-aligned in its column, live-measured
       368x177 (was 220x106) — justify-self shrinks the grid item to its
       image's own width so "end" actually moves it, instead of the item
       stretching to fill the column by grid's own default. */
    justify-self: end;
  }

  .steiermark-logo :global(img) {
    max-width: 368px;
    height: auto;
  }

  .steiermark-grid p {
    color: var(--color-surface);
    margin: 0;
    /* NACHTLAUF-2026-09-08.md B6: live 20px, not the 17px this measured at. */
    font-size: 1.25rem;
  }

  @media (min-width: 700px) {
    .steiermark-grid {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
