---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

// The live page has no narrative copy in its source at all -- the entire
// page is one embedded Microsoft Bookings calendar (see
// src/content/pages/de/termine.md).
const entry = await getEntry('pages', 'de/termine');
if (!entry) throw new Error('Content collection entry "pages/de/termine" not found');

const bookingUrl = 'https://outlook.office.com/book/ErstgesprchfrDichallein@persephone.at/?ismsaljsauthenabled';

// NIGHT-RUN.md Phase 4.3 / external-review.md finding #1b: the page had
// no explanatory copy at all -- just the word "Termine" and an embed.
// Rather than invent new marketing sentences, this reuses the two real,
// already-verified sentences that describe this exact same 20-minute,
// free, no-obligation "Kennenlernen" call elsewhere on the site:
// beratung.md's own line about the call itself, and angebote.md's
// "ohne jede Verpflichtung" framing.
const introFromBeratung = 'Das online Kennenlernen (ca. 20 Min.) ist kostenfrei und dient dem gegenseitigen Beschnuppern und der Klärung Deines Anliegens.';
const introFromAngebote = 'Zwanzig Minuten, online, ohne jede Verpflichtung.';
---

<BaseLayout locale="de" path="/termine/" title={`${entry.data.title} – Persephone`}>
  {/* Confirmed no hero image on the live page (RUN-2026-09-07.md Phase E):
     its raw HTML has no --awb-bg-image anywhere, unlike the six pages that
     do. */}
  <PageHero title={entry.data.title} image={false} />

  <section class="section">
    <div class="container booking-wrap">
      <p>{introFromBeratung}</p>
      <p>{introFromAngebote}</p>

      {/* NIGHT-RUN.md Phase 4.3 / external-review.md 3c: the live site
         only *links* to this Bookings URL -- clicking is the visitor's
         choice to contact Microsoft. Embedding it as an always-on iframe
         would contact Microsoft's servers on every page view before any
         consent, which is the one thing on this site that would require
         a cookie banner. Loading the iframe only after a click keeps
         that behavior, and the visible fallback link means the booking
         is never unreachable if a visitor doesn't click, or if the
         embed is blocked. */}
      <div id="booking-loader" class="booking-loader">
        <button type="button" id="booking-load-button" class="button button-primary">
          Kalender laden — dabei wird eine Verbindung zu Microsoft aufgebaut
        </button>
        <p class="booking-fallback">
          Oder <a href={bookingUrl}>direkt bei Microsoft buchen</a>, ohne den Kalender hier zu laden.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container section-narrow section-centered">
      <p>
        Allgemeine Fragen, ein Anliegen zu einem Workshop oder etwas anderes?
        Nutze dafür das <a href="/kontakt/">Kontaktformular</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ bookingUrl }}>
  const loader = document.getElementById('booking-loader');
  const button = document.getElementById('booking-load-button');
  button?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = bookingUrl;
    iframe.width = '100%';
    iframe.height = '750';
    iframe.style.border = '0';
    iframe.title = 'Terminbuchung';
    iframe.className = 'booking-iframe';
    loader?.replaceWith(iframe);
  });
</script>

<style>
  .booking-wrap {
    max-width: 56rem;
    margin-inline: auto;
  }

  .booking-loader {
    background: var(--color-bg-alt);
    border-radius: var(--radius);
    padding: 3rem 2rem;
    text-align: center;
  }

  .booking-fallback {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  :global(.booking-iframe) {
    border-radius: var(--radius);
  }
</style>
