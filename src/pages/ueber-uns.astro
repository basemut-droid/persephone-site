---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import ServiceCard from '../components/ServiceCard.astro';
import logoKongruenz from '../assets/pages/ueber-uns/logo-kongruenz-und-authentizitaet.png';
import marinaPortrait from '../assets/shared/marina-von-persephone.jpg';
import granatapfel from '../assets/hero/granatapfel-fruchtbarkeit.png';
import {
  parseMarkdownBlocks,
  paragraphs,
  stripEmphasis,
  parseLinkHeading,
  mdInlineHtml,
  BlockTracker,
} from '../lib/parseMarkdownBlocks';

// Über uns's full copy lives in src/content/pages/de/ueber-uns.md (Task 2's
// verbatim re-parse from persephone.at) as one flowing markdown body —
// deliberately unstructured there, since every page needs a different
// component breakdown. This page pulls the specific pieces it needs back
// out of that one source via parseMarkdownBlocks, rather than duplicating
// the copy into separate typed frontmatter fields (which would leave two
// places to edit the same sentence).
const entry = await getEntry('pages', 'de/ueber-uns');
if (!entry) throw new Error('Content collection entry "pages/de/ueber-uns" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

// Masthead: on the live page this is the same split-hero band the homepage
// uses (text column + a full-bleed portrait), not PageHero's plain banner —
// PageHero doesn't fit here and building a second hero-split component
// would just duplicate src/styles/global.css's .hero/.hero-grid, so this
// reuses that shared pattern directly. See CLAUDE.md.
const { eyebrow: heroEyebrow, title: heroTitle, intro: heroIntro } = tracker.heroFields(entry.data.title);

// LAUF-2026-09-10.md B7 Punkt 15: Marina asked for a specific two-line
// split — "Persephone ist die Frucht" / "der eigenen Krise" — not
// whatever the browser's own wrap happens to produce (which could strand
// "Krise" alone on its own line). A forced <br> guarantees the split;
// .hero-title-break (below, in this page's own <style>) keeps it off
// below a width where the first line wouldn't fit on its own, so a
// narrow phone still gets a natural, unforced wrap instead of a third
// line. heroTitle is this page's own known content, not user input —
// same trust boundary as parseMarkdownBlocks' other set:html call sites.
const heroTitleHtml = heroTitle.replace('Frucht der eigenen Krise', 'Frucht<br class="hero-title-break" />der eigenen Krise');

// "Wer Dir hier begegnet" / "Was aus meiner Kinderwunschkrise wuchs" /
// "Persephone als soziales Unternehmen" are one single centered section on
// the live page (no image) — reuses the existing .section-centered +
// .section-narrow utilities the homepage's pain-points section already
// established, rather than the two-column photo+text layout this page used
// to have (that pattern isn't in the live design at all).
const bioSections = ['Wer Dir hier begegnet', 'Was aus meiner Kinderwunschkrise wuchs', 'Persephone als soziales Unternehmen'].map(
  (heading) => ({ heading, paragraphs: paragraphs(tracker.section(heading)) })
);

const ausbildung = tracker.section('**Ausbildung**').find((b) => b.type === 'list');
const felderfahrung = tracker.section('**Felderfahrung**').find((b) => b.type === 'list');
const sprachen = paragraphs(tracker.section('**Sprachen**'));
if (ausbildung?.type !== 'list' || felderfahrung?.type !== 'list') {
  throw new Error('Expected "Ausbildung"/"Felderfahrung" sections to each contain a list');
}

// NACHTLAUF-2026-09-08.md B2.1: three full-bleed two-column bands, sides
// alternating (panel left / illustration right, then reversed, then
// again) — rebuilt from scratch rather than copied, since live's panel is
// info-bg-3.svg, an Avada asset (BILDRECHTE). "logo-kongruenz..." used to
// also render here as a 90x90 badge (B2.3's duplicate-tile bug — it
// belongs only in the closing CTA below, at 360x360) and is dropped from
// this data entirely rather than carried through unused.
const qualBands = [
  { heading: stripEmphasis('**Ausbildung**'), kind: 'list' as const, items: ausbildung.items, side: 'left' as const },
  { heading: stripEmphasis('**Felderfahrung**'), kind: 'list' as const, items: felderfahrung.items, side: 'right' as const },
  { heading: stripEmphasis('**Sprachen**'), kind: 'lines' as const, items: sprachen, side: 'left' as const },
];

// The two closing teaser-card headings link to persephone.at URLs that are
// live 404s (stale slugs left over from a page rename — see
// OPEN-QUESTIONS.md #6). The content-collection entry records them exactly
// as found on the source, per Task 2's "faithful record" rule; this page,
// actually being built and shipped, points at the real working pages
// instead of reproducing a dead link.
const deadLinkFixes: Record<string, string> = {
  'https://www.persephone.at/beratung-coaching/': '/beratung/',
  'https://www.persephone.at/workhops-einzeltrainings/': '/workshops/',
};
const teaserHeadings = blocks.filter((b) => b.type === 'heading' && b.level === 2 && parseLinkHeading(b.text));
const teasers = teaserHeadings.map((h) => {
  if (h.type !== 'heading') throw new Error('unreachable');
  const link = parseLinkHeading(h.text)!;
  const idx = blocks.indexOf(h);
  const next = blocks[idx + 1];
  tracker.use(h, next);
  return {
    label: link.label,
    href: deadLinkFixes[link.href] ?? link.href,
    description: next?.type === 'paragraph' ? next.text : '',
  };
});

const closing = tracker.section('Dein nächster Schritt');
const closingParagraphs = paragraphs(closing);
const closingCta = closing.find((b) => b.type === 'cta');
if (!closingCta || closingCta.type !== 'cta') throw new Error('Expected a closing CTA link after "Dein nächster Schritt"');
// The portrait/tile in the closing section (confirmed against the live
// page's raw HTML: same two-nested-column, transform+z-index composition as
// Angebote/Workshops/Beratung — RUN-2026-09-07.md Phase C) are
// statically-imported assets passed to ClosingCta below, not block data —
// accounted for via the .section() call above.
tracker.assertAllHandled('ueber-uns.astro');
---

<BaseLayout locale="de" path="/ueber-uns/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy reveal reveal-left">
        {heroEyebrow && <span class="eyebrow">{heroEyebrow}</span>}
        <h1 class="hero-headline heading-black" set:html={heroTitleHtml} />
        {heroIntro && <p>{heroIntro}</p>}
      </div>
      {
        entry.data.heroImage && (
          <div class="hero-image reveal reveal-right">
            <Image src={entry.data.heroImage} alt={entry.data.heroImageAlt ?? ''} width={1000} height={1500} />
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-alt section-centered">
    <div class="container section-narrow">
      {
        bioSections.map(({ heading, paragraphs: paras }) => (
          <>
            {/* NACHTLAUF-2026-09-09.md E1: live measures both headings at
               18px/400/uppercase/teal — the .eyebrow treatment, not a
               plain h2 (28px/dark/normal-case, what this rendered before). */}
            <h2 class="eyebrow">{heading}</h2>
            {paras.map((p) => <p set:html={mdInlineHtml(p)} />)}
          </>
        ))
      }
    </div>
  </section>

  {/* NACHTLAUF-2026-09-09.md E2: Claudio asked for the three qualification
     bands to read as one continuous "Faden" — scroll-linked crossfade
     between cards/images instead of three independently-scrolling rows.
     data-quals-scroller/data-quals-band are enhancement hooks only; the
     wrapper adds no layout of its own until the script below opts a
     capable, motion-OK, ≥900px viewport into it, so a plain render (no
     JS, old browser, prefers-reduced-motion, or narrow viewport) is
     pixel-identical to the previous three-independent-bands markup. */}
  <div class="quals-scroller" data-quals-scroller>
    {
      qualBands.map((band) => (
        <section class={`reveal quals-band quals-band--${band.side}`} data-quals-band>
          <div class="quals-grid">
            <div class="quals-panel">
              <h2 class="quals-heading">{band.heading}</h2>
              {band.kind === 'list' ? (
                <ul class="quals-list">
                  {band.items.map((item) => (
                    <li set:html={mdInlineHtml(item)} />
                  ))}
                </ul>
              ) : (
                <div class="quals-list quals-lines">
                  {band.items.map((line) => (
                    <p>{line}</p>
                  ))}
                </div>
              )}
            </div>
            <div class="quals-image">
              <Image src={granatapfel} alt="" aria-hidden="true" width={1000} height={800} />
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <script>
    // NACHTLAUF-2026-09-09.md E2 — scroll-linked crossfade, progressive
    // enhancement in the same spirit as global.css's .reveal (A6): opt in
    // only once IntersectionObserver exists, prefers-reduced-motion isn't
    // set, and the viewport is wide enough for the alternating two-column
    // band layout this crossfade is built for (matches the existing
    // 900px breakpoint the bands themselves already use). Everyone else
    // keeps the plain stacked-bands render with its own existing .reveal
    // fade-in untouched.
    const scroller = document.querySelector<HTMLElement>('[data-quals-scroller]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (scroller && !prefersReducedMotion && 'IntersectionObserver' in window && window.matchMedia('(min-width: 900px)').matches) {
      const bands = [...scroller.querySelectorAll<HTMLElement>('[data-quals-band]')];
      scroller.classList.add('quals-scroller--enhanced');
      // Hand full control of these bands' opacity to the observer below —
      // otherwise BaseLayout's own generic .reveal-pending toggle and this
      // one would both be driving the same property.
      bands.forEach((b) => b.classList.remove('reveal', 'reveal-pending'));
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) entry.target.classList.toggle('is-quals-active', entry.isIntersecting);
        },
        { threshold: 0 },
      );
      bands.forEach((b) => io.observe(b));
    }
  </script>

  {/* NACHTLAUF-2026-09-09.md E3: Claudio's call — the photo+overlapping-
     card layout below (NIGHT-RUN.md Phase 4.2 / external-review.md #4b)
     stays out of the render for now in favor of the same teal
     ServiceCard/"ERFAHRE MEHR" gradient cards the homepage already uses
     for Beratung & Coaching / Workshops & Einzeltrainings (screenshot
     07 in docs/screenshots/2026-09-09-feedback/) — same content
     (title/description/href from `teasers`), reusing ServiceCard/
     .service-grid rather than building a second version of that shape
     (CLAUDE.md "reuse before you build"). The photo-teaser markup/style
     it replaces is commented out just below rather than deleted: it's
     the calibrated real-photo layout (FEEDBACK-2026-09-08.md #1's
     measurements, confirmed same size as the live photos in screenshot
     06) for whenever real photos exist and Marina edits this in the
     CMS. */}
  <section class="section section-alt">
    <div class="container">
      <div class="service-grid">
        {
          teasers.map((t, i) => (
            <ServiceCard
              title={t.label}
              description={t.description}
              href={t.href}
              cta="Erfahre mehr"
              tone={i === 0 ? 'teal-dark' : 'teal'}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* --- Photo-teaser backup, NACHTLAUF-2026-09-09.md E3 ---
  <section class="section section-alt">
    <div class="container photo-teaser-grid">
      {teasers.map((t, i) => (
        <article class={`photo-teaser photo-teaser--${i === 0 ? 'a' : 'b'}`}>
          <div class="photo-teaser-image" aria-hidden="true">
            <ImagePlaceholder />
          </div>
          <div class="photo-teaser-card">
            <h3 class="eyebrow photo-teaser-eyebrow">
              <a href={t.href}>{t.label}</a>
            </h3>
            <p>{t.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  Reactivate by uncommenting this block, re-adding
  `import ImagePlaceholder from '../components/ImagePlaceholder.astro';`,
  and removing the ServiceCard section above (or the .photo-teaser-grid
  CSS below, which is likewise left in place, unused, for the same reason).
  --- */}

  <ClosingCta
    heading="Dein nächster Schritt"
    paragraphs={closingParagraphs}
    ctaLabel={closingCta.text}
    ctaHref={closingCta.href}
    portrait={marinaPortrait}
    portraitAlt="Porträtfoto von Marina Bletsas, Gründerin von Persephone"
    tile={logoKongruenz}
    tileAlt=""
    headingSize="large"
    portraitSize="large"
  />
</BaseLayout>

<style>
  /* .hero/.hero-grid/.hero-copy/.hero-headline/.hero-image are shared
     (global.css) — nothing page-specific to add for the masthead. */

  /* B7 Punkt 15: suppressed by default so a narrow phone gets the
     browser's own natural wrap instead of a forced break stacking a third
     line under it; 480px is comfortably past where "Persephone ist die
     Frucht" alone needs to wrap at this H1's own clamp()'d size. Not
     live-measured against an actual phone — see the handoff report. */
  .hero-title-break {
    display: none;
  }

  @media (min-width: 480px) {
    .hero-title-break {
      display: block;
    }
  }

  /* B7 Punkt 15, continued: the shared .hero-copy's fixed 500px (≥900px,
     global.css) is too narrow for "Persephone ist die Frucht" to hold one
     line at this H1's 48px size — it wrapped a second time on its own
     before reaching the forced break above, landing on three lines
     instead of two. Screenshot-verified against the running dev server.
     Widened for this page only, not changed globally (A2 keeps the H1
     size itself "identisch" to live, so the fix is the column, not the
     type). */
  @media (min-width: 900px) {
    .hero-copy {
      width: 640px;
    }
  }

  /* Qualification bands (NACHTLAUF-2026-09-08.md B2.1) — three full-bleed
     two-column rows, alternating sides. Page-scoped, not global.css: this
     shape (a solid-color column stretching the full row height, paired
     with an image column, alternating per row) doesn't exist anywhere
     else on the site yet — see CLAUDE.md's "reuse before you build" rule,
     which cuts both ways: not promoting a one-off speculatively either.
     Revisit if a future page needs the same alternating-band shape. */
  .quals-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .quals-panel {
    /* LAUF-2026-09-10.md B7 Punkt 17: Marina asked for a lighter green with
       more contrast — those two goals conflict at face value (a lighter
       fill against the same light text loses contrast, not gains it), so
       the fix flips the text to dark instead of just swapping the fill:
       --color-sage (lighter, what she asked for) behind --color-text
       (dark) measures 9.18:1, versus 2.96:1 for the old
       teal-dark/light-text pairing — lighter fill AND better contrast,
       both true at once. */
    background: var(--color-sage);
    color: var(--color-text);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .quals-heading {
    color: inherit;
    margin-bottom: 1.5rem;
  }

  .quals-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    /* B7 Punkt 17 "Textfont größer": was the browser's unset default
       (~16px, smaller than the rest of the page) — now matches the site's
       own Fließtext size, not smaller, as asked. */
    font-size: 1.25rem;
  }

  /* NACHTLAUF-2026-09-09.md E2: live's Ausbildung/Felderfahrung items are
     real left-aligned bullet lists (list-style: disc, text-align: start) —
     not centered marker-less lines. Scoped to the <ul> variant only, so
     the Sprachen band (a <div class="quals-list quals-lines">, no bullets
     there) keeps its own centered treatment from .quals-panel. */
  ul.quals-list {
    list-style: disc;
    padding-left: 1.25rem;
    text-align: left;
  }

  /* Language lines: NACHTLAUF-2026-09-08.md B2.1 measures these at 34px on
     the live page — its own size, not the 20px body default. */
  .quals-lines p {
    font-size: 2.125rem;
    margin: 0;
  }

  .quals-image {
    /* Same construction as .hero-image/.hero-image img (global.css) and
       for the same reason — NACHTLAUF-2026-09-08.md A0: the img is taken
       out of flow so it can never feed its own intrinsic aspect-ratio back
       into the grid row's auto-sizing pass. */
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .quals-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .quals-grid {
      grid-template-columns: 1fr 1fr;
      min-height: 26rem;
    }

    .quals-image {
      aspect-ratio: auto;
      height: 100%;
    }

    /* Alternating sides: the panel is always the band's first DOM child
       (markup stays simple/linear either way) — order flips which side it
       renders on. */
    .quals-band--right .quals-panel {
      order: 2;
    }

    /* NACHTLAUF-2026-09-09.md E2 crossfade, enhanced state only (see the
       script above): each band becomes a full-viewport sticky slide that
       pins at the top and covers the previous one as it comes in — the
       classic "later sibling paints over earlier" scroll-stack technique,
       needing no scroll-position math or extra spacer height, since the
       bands' own stacked block height already provides the scroll
       distance. */
    .quals-scroller--enhanced .quals-band {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    /* LAUF-2026-09-10.md B7 Punkt 18: the fade used to sit on the whole
       band (.quals-band, panel and image together) — while it animated in,
       the incoming band's own TEXT was semi-transparent, so the previous
       band's pomegranate image showed straight through it. Marina liked
       the overlap, not the see-through text. Moved to .quals-image alone:
       the picture side still crossfades (the "Kante" she says can stay
       transparent), the text panel is opaque and instant, on solid ground,
       the moment its band is stacked into place. */
    .quals-scroller--enhanced .quals-image {
      opacity: 0;
      transition: opacity 0.6s ease;
    }

    .quals-scroller--enhanced .quals-band.is-quals-active .quals-image {
      opacity: 1;
    }

    .quals-scroller--enhanced .quals-grid {
      height: 100%;
    }
  }

  /* Photo + overlapping text-card teasers (external-review.md finding
     #4b). Currently unused — NACHTLAUF-2026-09-09.md E3 swapped the
     teasers themselves for ServiceCard/.service-grid above, but this CSS
     stays as part of the commented-out backup markup's documentation
     (uncomment both together). Page-scoped, not global.css: this exact
     photo/card-overlap shape doesn't exist anywhere else on the site yet
     — see CLAUDE.md's "reuse before you build" rule, which cuts both
     ways: it also means not promoting a one-off to global.css
     speculatively. The old .teaser-grid/.teaser-card generic cards this
     replaced (no image, no overlap) were themselves a placeholder for
     this real design and are removed from global.css now that nothing
     needs them. */
  .photo-teaser-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    /* Room for the text cards to break past the photo's edges without
       colliding with the section padding or each other. */
    padding-block: 1rem 3rem;
  }

  .photo-teaser {
    position: relative;
  }

  /* Own aspect ratio per side (docs/FEEDBACK-2026-09-08.md #1: measured
     420x575 / 680x635 at 1440px) — the left photo is a tall portrait, the
     right one near-square. */
  .photo-teaser--a .photo-teaser-image {
    aspect-ratio: 420 / 575;
  }

  .photo-teaser--b .photo-teaser-image {
    aspect-ratio: 680 / 635;
  }

  .photo-teaser-image {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .photo-teaser-card {
    /* FEEDBACK-2026-09-08.md #1: #fbf8f5 (--color-bg), not the beige
       --color-bg-alt this used to sit on. */
    background: var(--color-bg);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(24, 26, 43, 0.12);
    padding: 1.75rem 2rem;
    position: relative;
    max-width: 22rem;
    /* Mobile/stacked fallback: a plain card below its photo, pulled up
       slightly over the bottom edge (the same overlap idea as the ≥900px
       rule below, just without the precise 130px figure that rule is
       measured for). */
    margin-top: -3rem;
    margin-inline: 1.5rem;
  }

  /* .eyebrow (global.css) provides the shape (uppercase, letter-spacing,
     size, weight) — this only overrides its default teal for the
     terracotta external-review.md confirmed here, and styles the link
     the heading now wraps (task 5b: swap the element, keep the class;
     the credentials columns already do this for a plain-text eyebrow —
     this one wraps a link instead, since the heading itself is the
     teaser's only click target). */
  .photo-teaser-eyebrow {
    color: var(--color-accent-strong);
    margin-bottom: 0.5rem;
  }

  .photo-teaser-eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .photo-teaser-eyebrow a:hover {
    text-decoration: underline;
  }

  .photo-teaser-card p {
    margin: 0;
  }

  /* FEEDBACK-2026-09-08.md #1 / NACHTLAUF-2026-09-08.md B2.2 — live-measured
     rules, not eyeballed: block 1200px wide, 420fr/680fr columns (the
     photos' own widths, so fr keeps that exact ratio at any container
     width) with a fixed 100px gap between them; the right photo starts
     30px higher than the left (a margin-top on the left one instead of a
     negative one on the right, so the grid's own row-height calculation —
     driven only by the in-flow photos — still comes out right); each card
     is left-aligned with its own photo, sized to ~75%/77% of the photo's
     width, and anchored to the photo's bottom edge plus exactly 130px via
     position: absolute + bottom: -130px, growing upward as its text does
     rather than a fixed height. The measured "right card sits 150px lower
     than the left" isn't hardcoded separately — it falls out of the -30px
     photo offset plus each card's own (different) height under this same
     bottom-anchor rule, so it keeps holding even if the copy length (and
     so the card height) changes later; verified against the 5-value table
     in FEEDBACK #1 by direct arithmetic before implementing this way. */
  @media (min-width: 900px) {
    .photo-teaser-grid {
      grid-template-columns: 420fr 680fr;
      column-gap: 100px;
      row-gap: 0;
      max-width: 1200px;
      align-items: start;
      padding-block: 1rem 150px;
    }

    .photo-teaser--a {
      margin-top: 30px;
    }

    .photo-teaser-card {
      position: absolute;
      left: 0;
      bottom: -130px;
      margin: 0;
      max-width: none;
    }

    .photo-teaser--a .photo-teaser-card {
      width: 75%;
    }

    .photo-teaser--b .photo-teaser-card {
      width: 77%;
    }
  }
</style>
