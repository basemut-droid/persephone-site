---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import logoKongruenz from '../assets/pages/ueber-uns/logo-kongruenz-und-authentizitaet.png';
import marinaPortrait from '../assets/shared/marina-von-persephone.jpg';
import granatapfel from '../assets/hero/granatapfel-fruchtbarkeit.png';
import {
  parseMarkdownBlocks,
  paragraphs,
  stripEmphasis,
  parseLinkHeading,
  mdInlineHtml,
  BlockTracker,
} from '../lib/parseMarkdownBlocks';

// Über uns's full copy lives in src/content/pages/de/ueber-uns.md (Task 2's
// verbatim re-parse from persephone.at) as one flowing markdown body —
// deliberately unstructured there, since every page needs a different
// component breakdown. This page pulls the specific pieces it needs back
// out of that one source via parseMarkdownBlocks, rather than duplicating
// the copy into separate typed frontmatter fields (which would leave two
// places to edit the same sentence).
const entry = await getEntry('pages', 'de/ueber-uns');
if (!entry) throw new Error('Content collection entry "pages/de/ueber-uns" not found');
const blocks = parseMarkdownBlocks(entry.body ?? '');
const tracker = new BlockTracker(blocks);

// Masthead: on the live page this is the same split-hero band the homepage
// uses (text column + a full-bleed portrait), not PageHero's plain banner —
// PageHero doesn't fit here and building a second hero-split component
// would just duplicate src/styles/global.css's .hero/.hero-grid, so this
// reuses that shared pattern directly. See CLAUDE.md.
const { eyebrow: heroEyebrow, title: heroTitle, intro: heroIntro } = tracker.heroFields(entry.data.title);

// LAUF-2026-09-10.md B7 Punkt 15: Marina asked for a specific two-line
// split — "Persephone ist die Frucht" / "der eigenen Krise" — not
// whatever the browser's own wrap happens to produce (which could strand
// "Krise" alone on its own line). A forced <br> guarantees the split;
// .hero-title-break (below, in this page's own <style>) keeps it off
// below a width where the first line wouldn't fit on its own, so a
// narrow phone still gets a natural, unforced wrap instead of a third
// line. heroTitle is this page's own known content, not user input —
// same trust boundary as parseMarkdownBlocks' other set:html call sites.
const heroTitleHtml = heroTitle.replace('Frucht der eigenen Krise', 'Frucht<br class="hero-title-break" />der eigenen Krise');

// "Wer Dir hier begegnet" / "Was aus meiner Kinderwunschkrise wuchs" /
// "Persephone als soziales Unternehmen" are one single centered section on
// the live page (no image) — reuses the existing .section-centered +
// .section-narrow utilities the homepage's pain-points section already
// established, rather than the two-column photo+text layout this page used
// to have (that pattern isn't in the live design at all).
const bioSections = ['Wer Dir hier begegnet', 'Was aus meiner Kinderwunschkrise wuchs', 'Persephone als soziales Unternehmen'].map(
  (heading) => ({ heading, paragraphs: paragraphs(tracker.section(heading)) })
);

const ausbildung = tracker.section('**Ausbildung**').find((b) => b.type === 'list');
const felderfahrung = tracker.section('**Felderfahrung**').find((b) => b.type === 'list');
const sprachen = paragraphs(tracker.section('**Sprachen**'));
if (ausbildung?.type !== 'list' || felderfahrung?.type !== 'list') {
  throw new Error('Expected "Ausbildung"/"Felderfahrung" sections to each contain a list');
}

// NACHTLAUF-2026-09-08.md B2.1: three full-bleed two-column bands, sides
// alternating (panel left / illustration right, then reversed, then
// again) — rebuilt from scratch rather than copied, since live's panel is
// info-bg-3.svg, an Avada asset (BILDRECHTE). "logo-kongruenz..." used to
// also render here as a 90x90 badge (B2.3's duplicate-tile bug — it
// belongs only in the closing CTA below, at 360x360) and is dropped from
// this data entirely rather than carried through unused.
const qualBands = [
  { heading: stripEmphasis('**Ausbildung**'), kind: 'list' as const, items: ausbildung.items, side: 'left' as const },
  { heading: stripEmphasis('**Felderfahrung**'), kind: 'list' as const, items: felderfahrung.items, side: 'right' as const },
  { heading: stripEmphasis('**Sprachen**'), kind: 'lines' as const, items: sprachen, side: 'left' as const },
];

// The two closing teaser-card headings link to persephone.at URLs that are
// live 404s (stale slugs left over from a page rename — see
// OPEN-QUESTIONS.md #6). The content-collection entry records them exactly
// as found on the source, per Task 2's "faithful record" rule; this page,
// actually being built and shipped, points at the real working pages
// instead of reproducing a dead link.
const deadLinkFixes: Record<string, string> = {
  'https://www.persephone.at/beratung-coaching/': '/beratung/',
  'https://www.persephone.at/workhops-einzeltrainings/': '/workshops/',
};
const teaserHeadings = blocks.filter((b) => b.type === 'heading' && b.level === 2 && parseLinkHeading(b.text));
const teasers = teaserHeadings.map((h) => {
  if (h.type !== 'heading') throw new Error('unreachable');
  const link = parseLinkHeading(h.text)!;
  const idx = blocks.indexOf(h);
  const next = blocks[idx + 1];
  tracker.use(h, next);
  return {
    label: link.label,
    href: deadLinkFixes[link.href] ?? link.href,
    description: next?.type === 'paragraph' ? next.text : '',
  };
});

const closing = tracker.section('Dein nächster Schritt');
const closingParagraphs = paragraphs(closing);
const closingCta = closing.find((b) => b.type === 'cta');
if (!closingCta || closingCta.type !== 'cta') throw new Error('Expected a closing CTA link after "Dein nächster Schritt"');
// The portrait/tile in the closing section (confirmed against the live
// page's raw HTML: same two-nested-column, transform+z-index composition as
// Angebote/Workshops/Beratung — RUN-2026-09-07.md Phase C) are
// statically-imported assets passed to ClosingCta below, not block data —
// accounted for via the .section() call above.
tracker.assertAllHandled('ueber-uns.astro');
---

<BaseLayout locale="de" path="/ueber-uns/" title={`${entry.data.title} – Persephone`} description={entry.data.description}>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy reveal reveal-left">
        {heroEyebrow && <span class="eyebrow">{heroEyebrow}</span>}
        <h1 class="hero-headline heading-black" set:html={heroTitleHtml} />
        {heroIntro && <p>{heroIntro}</p>}
      </div>
      {
        entry.data.heroImage && (
          <div class="hero-image reveal reveal-right">
            <Image src={entry.data.heroImage} alt={entry.data.heroImageAlt ?? ''} width={1000} height={1500} />
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-alt section-centered">
    <div class="container section-narrow">
      {
        bioSections.map(({ heading, paragraphs: paras }) => (
          <>
            {/* NACHTLAUF-2026-09-09.md E1: live measures both headings at
               18px/400/uppercase/teal — the .eyebrow treatment, not a
               plain h2 (28px/dark/normal-case, what this rendered before). */}
            <h2 class="eyebrow">{heading}</h2>
            {paras.map((p) => <p set:html={mdInlineHtml(p)} />)}
          </>
        ))
      }
    </div>
  </section>

  {/* NACHTLAUF-2026-09-09.md E2: Claudio asked for the three qualification
     bands to read as one continuous "Faden" — scroll-linked crossfade
     between cards/images instead of three independently-scrolling rows.
     data-quals-scroller/data-quals-band are enhancement hooks only; the
     wrapper adds no layout of its own until the script below opts a
     capable, motion-OK, ≥900px viewport into it, so a plain render (no
     JS, old browser, prefers-reduced-motion, or narrow viewport) is
     pixel-identical to the previous three-independent-bands markup.

     NACHTRAG-2026-09-11.md N4: the previous enhanced layout made each
     band itself `position: sticky; top: 0`, stacked one after another in
     normal flow — visually that reads as the next band sliding up and
     covering the previous one while scrolling, not a fade in place
     (Claudio: "more like a slide in whereas the original vanishes while
     the other appears"). The new [data-quals-stage] wrapper is the fix:
     it alone becomes the sticky viewport, and the bands inside it are
     absolutely stacked on top of each other at the exact same spot —
     opacity is then the only thing that ever changes, so nothing moves.
     The scroller itself still gets an explicit multi-viewport-tall height
     (set by the script below) purely to keep the same three-stage scroll
     distance as before. */}
  <div class="quals-scroller" data-quals-scroller>
    <div class="quals-stage" data-quals-stage>
      {
        qualBands.map((band) => (
          <section class={`reveal quals-band quals-band--${band.side}`} data-quals-band>
            {/* Live correction (same session as N2-N4): "almost the width
               of the page", explicitly wider than the site's usual
               .container (max-width 1248px) — deliberate full-bleed
               treatment for this one component, not a reuse-before-you-
               build violation (CLAUDE.md's rule cuts both ways: it also
               means not forcing every section into the shared .container
               when the live design genuinely wants something wider). */}
            <div class="quals-container">
              <div class="quals-grid">
                <div class="quals-panel">
                  <h2 class="quals-heading">{band.heading}</h2>
                  {band.kind === 'list' ? (
                    <ul class="quals-list">
                      {band.items.map((item) => (
                        <li set:html={mdInlineHtml(item)} />
                      ))}
                    </ul>
                  ) : (
                    <div class="quals-list quals-lines">
                      {band.items.map((line) => (
                        <p>{line}</p>
                      ))}
                    </div>
                  )}
                </div>
                <div class="quals-image">
                  <Image src={granatapfel} alt="" aria-hidden="true" width={1000} height={800} />
                </div>
              </div>
            </div>
          </section>
        ))
      }
      {/* Live correction: a slideshow-position indicator (a small pill
         with one dot per band, the current one highlighted) sitting to
         the right — matches the original page, which shows this next to
         the alternating panel/image bands. Lives inside [data-quals-stage]
         itself, not as a scroller-level sibling: the stage is what's
         position:sticky, so nesting the indicator here means it's pinned
         (and disappears) exactly in step with the bands it's indexing —
         a sibling positioned `fixed` to the viewport instead would keep
         showing long after the crossfade section has scrolled by, since
         .quals-scroller--enhanced never gets removed once scrolled past.
         Enhancement-only: it only means anything once there's an actual
         "current slide" (the crossfade state below), so it's hidden by
         default and only shown once .quals-scroller--enhanced is
         present — the same gate the crossfade itself uses. */}
      <div class="quals-indicator" data-quals-indicator aria-hidden="true">
        {qualBands.map((_, i) => <span class="quals-indicator-dot" data-quals-dot={i} />)}
      </div>
    </div>
  </div>

  <script>
    // NACHTLAUF-2026-09-09.md E2 — scroll-linked crossfade, progressive
    // enhancement in the same spirit as global.css's .reveal (A6): opt in
    // only once prefers-reduced-motion isn't set and the viewport is wide
    // enough for the alternating two-column band layout this crossfade is
    // built for (matches the existing 900px breakpoint the bands
    // themselves already use). Everyone else keeps the plain
    // stacked-bands render with its own existing .reveal fade-in
    // untouched.
    //
    // NACHTRAG-2026-09-11.md N4: switched from IntersectionObserver
    // (which needed each band to occupy its own moving scroll slot — the
    // very thing that caused the "slide" look) to reading scroll progress
    // directly off the scroller's own bounding box. The bands no longer
    // move at all (see the CSS below), so there's nothing left for an
    // observer to watch; the active band is simply whichever third of the
    // scroller's height the viewport currently sits over.
    const scroller = document.querySelector<HTMLElement>('[data-quals-scroller]');
    const stage = document.querySelector<HTMLElement>('[data-quals-stage]');
    const indicator = document.querySelector<HTMLElement>('[data-quals-indicator]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (scroller && stage && !prefersReducedMotion && window.matchMedia('(min-width: 900px)').matches) {
      const bands = [...scroller.querySelectorAll<HTMLElement>('[data-quals-band]')];
      const dots = indicator ? [...indicator.querySelectorAll<HTMLElement>('[data-quals-dot]')] : [];
      scroller.classList.add('quals-scroller--enhanced');
      // Hand full control of these bands' opacity to the scroll handler
      // below — otherwise BaseLayout's own generic .reveal-pending toggle
      // and this one would both be driving the same property.
      bands.forEach((b) => b.classList.remove('reveal', 'reveal-pending'));
      // Explicit scroll distance: one full viewport per band, same total
      // as the old "each band is its own 100vh sticky slide" approach.
      scroller.style.height = `${bands.length * 100}vh`;

      let queued = false;
      function updateActive() {
        queued = false;
        const rect = scroller!.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(Math.max(-rect.top, 0), scrollable) / scrollable : 0;
        const active = Math.min(bands.length - 1, Math.floor(progress * bands.length));
        bands.forEach((b, i) => b.classList.toggle('is-quals-active', i === active));
        dots.forEach((d, i) => d.classList.toggle('is-quals-active', i === active));
      }
      function onScroll() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(updateActive);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', updateActive);
      updateActive();
    }
  </script>

  {/* docs/NACHTRAG-2026-09-11.md N1: the colored-tile/oversized-card
     pattern ("Button-Kästchen") belongs here, not on Angebote — Marina's
     screenshot for LAUF-2026-09-10.md B8 Punkt 19 showed these exact two
     cards ("Beratung & Coaching (i.A.u.S.)" / "Workshops & trainings"),
     which only exist on Über uns; a misreading filed it under Angebote
     instead. The shape itself (colored bg tile + oversized text card
     overlapping it, same superimposition idea as ClosingCta's
     photo/logo pair) is unchanged from that build — only its page moved,
     per N1's "Gestaltung übernommen, nicht der Ort". Content stays
     exactly what it was here before (`teasers`' own label/description/
     href from this page's markdown, unrelated to N1's move). The
     photo+overlapping-card layout below (NIGHT-RUN.md Phase 4.2 /
     external-review.md #4b) stays commented out for the same reason as
     before — NACHTLAUF-2026-09-09.md E3 — the calibrated real-photo
     layout (FEEDBACK-2026-09-08.md #1's measurements) for whenever real
     photos exist. */}
  <section class="section section-alt">
    <div class="container">
      <div class="offer-tiles">
        {
          teasers.map((t, i) => (
            <a href={t.href} class="offer-tile">
              <div class={`offer-tile-bg offer-tile-bg--${i === 0 ? 'teal-dark' : 'teal'}`} aria-hidden="true" />
              <div class="offer-tile-card">
                <h3 class="offer-tile-title">{t.label}</h3>
                <p>{t.description}</p>
                <span class="offer-tile-cta">Erfahre mehr</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* --- Photo-teaser backup, NACHTLAUF-2026-09-09.md E3 ---
  <section class="section section-alt">
    <div class="container photo-teaser-grid">
      {teasers.map((t, i) => (
        <article class={`photo-teaser photo-teaser--${i === 0 ? 'a' : 'b'}`}>
          <div class="photo-teaser-image" aria-hidden="true">
            <ImagePlaceholder />
          </div>
          <div class="photo-teaser-card">
            <h3 class="eyebrow photo-teaser-eyebrow">
              <a href={t.href}>{t.label}</a>
            </h3>
            <p>{t.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  Reactivate by uncommenting this block, re-adding
  `import ImagePlaceholder from '../components/ImagePlaceholder.astro';`,
  and removing the ServiceCard section above (or the .photo-teaser-grid
  CSS below, which is likewise left in place, unused, for the same reason).
  --- */}

  <ClosingCta
    heading="Dein nächster Schritt"
    paragraphs={closingParagraphs}
    ctaLabel={closingCta.text}
    ctaHref={closingCta.href}
    portrait={marinaPortrait}
    portraitAlt="Porträtfoto von Marina Bletsas, Gründerin von Persephone"
    tile={logoKongruenz}
    tileAlt=""
    headingSize="large"
    portraitSize="large"
  />
</BaseLayout>

<style>
  /* .hero/.hero-grid/.hero-copy/.hero-headline/.hero-image are shared
     (global.css) — nothing page-specific to add for the masthead. */

  /* B7 Punkt 15: suppressed by default so a narrow phone gets the
     browser's own natural wrap instead of a forced break stacking a third
     line under it; 480px is comfortably past where "Persephone ist die
     Frucht" alone needs to wrap at this H1's own clamp()'d size. Not
     live-measured against an actual phone — see the handoff report. */
  .hero-title-break {
    display: none;
  }

  @media (min-width: 480px) {
    .hero-title-break {
      display: block;
    }
  }

  /* B7 Punkt 15, continued: the shared .hero-copy's fixed 500px (≥900px,
     global.css) is too narrow for "Persephone ist die Frucht" to hold one
     line at this H1's 48px size — it wrapped a second time on its own
     before reaching the forced break above, landing on three lines
     instead of two. Screenshot-verified against the running dev server.
     Widened for this page only, not changed globally (A2 keeps the H1
     size itself "identisch" to live, so the fix is the column, not the
     type). */
  @media (min-width: 900px) {
    .hero-copy {
      width: 640px;
    }
  }

  /* docs/NACHTRAG-2026-09-11.md N1 — moved here verbatim from
     angebote.astro (LAUF-2026-09-10.md B8 Punkt 19's original build):
     same overlap idea as ClosingCta's tile/portrait — a colored square
     behind, a smaller card offset over its bottom-left corner.
     Live correction, 2026-09-11: originally the card nearly matched the
     tile's own height (top:1.5rem to bottom:-1.5rem, 82% width), leaving
     only a thin sliver of the colored square visible — same complaint as
     ClosingCta's old proportions, fixed the same way just now: the
     background tile is square (was 4/3) and the card shrinks to a
     bottom-left-anchored, content-sized box so the square actually reads
     as a square instead of a border peeking out from behind the card. */
  .offer-tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .offer-tile {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--color-text);
    padding: 0 0 3rem 1.5rem;
  }

  /* Live correction, 2026-09-11: the square background tile was still
     the tile's full column width (100%) while the card above it had
     already been shrunk to 68% — leaving the background noticeably
     bigger than the card sitting on it, the opposite of a matched pair.
     Shrunk to a size close to the card's own (78%, right-aligned) so the
     two read as similarly-sized offset elements, the same relationship
     ClosingCta's tile/portrait pair now has. */
  .offer-tile-bg {
    width: 78%;
    margin-left: auto;
    border-radius: var(--radius);
    aspect-ratio: 1 / 1;
  }

  .offer-tile-bg--teal-dark {
    background: var(--color-teal-dark);
  }

  .offer-tile-bg--teal {
    background: var(--color-teal);
  }

  .offer-tile-card {
    position: absolute;
    left: 0;
    bottom: -1.5rem;
    width: 70%;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(24, 26, 43, 0.12);
    padding: 1.5rem 1.75rem;
    transition: transform 0.18s ease;
  }

  .offer-tile:hover .offer-tile-card {
    transform: translateY(-2px);
  }

  .offer-tile-title {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }

  .offer-tile-card p {
    margin: 0 0 1rem;
  }

  .offer-tile-cta {
    font-weight: 600;
    color: var(--color-accent-strong);
  }

  @media (min-width: 700px) {
    .offer-tiles {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Qualification bands (NACHTLAUF-2026-09-08.md B2.1) — three full-bleed
     two-column rows, alternating sides. Page-scoped, not global.css: this
     shape (a solid-color column stretching the full row height, paired
     with an image column, alternating per row) doesn't exist anywhere
     else on the site yet — see CLAUDE.md's "reuse before you build" rule,
     which cuts both ways: not promoting a one-off speculatively either.
     Revisit if a future page needs the same alternating-band shape. */
  /* Live-Korrektur: die Bänder liefen vorher randlos volle Breite; der
     Referenz-Screenshot zeigt zwei eigenständige, abgerundete Kästchen
     mit Zwischenraum und seitlichem Container-Rand, kein Vollbild-Band. */
  .quals-band {
    background: var(--color-bg-alt);
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .quals-container {
    height: 100%;
    display: flex;
    align-items: center;
    /* Live correction: deliberately not the shared .container (max-width
       1248px) — "almost the width of the page", not the site's usual
       reading-width measure. 2vw keeps a small gutter that grows with the
       viewport instead of a fixed one that would look cramped on very
       wide screens or too tight on narrower ones. */
    width: 100%;
    max-width: 1800px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 2vw, 2rem);
  }

  .quals-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
  }

  .quals-panel {
    /* Live-Korrektur, mit gemessenem Screenshot verglichen: die hellere,
       kontrastreiche Fläche aus B7 Punkt 17 (--color-sage + dunkler Text,
       9.18:1) war nicht das gewünschte Bild — Referenz-Screenshot zeigt
       eine dunklere, satte Fläche (gemessen: fast exakt #309898,
       --color-teal-dark) mit hellem Text, wie ursprünglich vor Punkt 17.
       Kontrast damit wieder 2.96:1 statt 9.18:1 — niedriger als der
       4,5:1-Standard für Fließtext, ein bewusster Trade-off dieser
       expliziten Vorgabe (siehe OPEN-QUESTIONS.md).
       NACHTRAG-2026-09-11.md N3: der abgerundete Rostorange-Akzent
       (::after, #c26d32) ist ersatzlos entfernt — er war genau das
       ockerfarbene Element, das laut LAUF-2026-09-10.md "NICHT ANFASSEN"
       projektweit ausgeschlossen ist. Live-Korrektur direkt danach, im
       selben Gespräch: die diagonale Streifentextur (::before, ein
       heller Wellenmuster-Annäherung an die Referenzgrafik) ist auf
       ausdrücklichen Wunsch ebenfalls entfernt — eine reine Flatfarbe
       ohne Textur, kein Ersatzmuster. */
    position: relative;
    background: var(--color-teal-dark);
    color: var(--color-bg);
    /* NACHTRAG-2026-09-11.md N2: live measures 115px inner padding on the
       (now much wider, see .quals-grid below) panel — the old clamp
       topped out at 3-4rem (48-64px) because it was sized for a
       half-width column, not this one's two-thirds. 8vw reaches the
       115px (7.1875rem) cap right around 1440px viewport width, where
       it was measured; verified 86.4px at 1440 with 6vw first, corrected
       to 8vw. */
    padding: clamp(2.5rem, 8vw, 7.1875rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    border-radius: 1rem;
  }

  .quals-heading,
  .quals-list {
    position: relative;
  }

  .quals-heading {
    color: inherit;
    margin-bottom: 1.5rem;
  }

  .quals-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    /* B7 Punkt 17 "Textfont größer": was the browser's unset default
       (~16px, smaller than the rest of the page) — now matches the site's
       own Fließtext size, not smaller, as asked. */
    font-size: 1.25rem;
  }

